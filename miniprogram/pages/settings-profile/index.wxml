<view class="page">
  <view class="card profile-card" wx:if="{{profile}}">
    <view class="profile-summary">
      <image wx:if="{{profile.avatarUrl}}" class="profile-avatar" src="{{profile.avatarUrl}}" mode="aspectFill"/>
      <view wx:else class="profile-avatar profile-avatar-default">{{profileInitial}}</view>
      <view class="profile-copy"><view>{{profile.nickname || '未设置昵称'}}</view><text>{{profile.position || '未填写职务'}}</text></view>
    </view>
    <view class="details">
      <view><text>单位</text><text>{{profile.organization || '未填写'}}</text></view>
      <view><text>城市</text><text>{{profile.city || '未填写'}}</text></view>
      <view><text>个人简介</text><text>{{profile.bio || '未填写'}}</text></view>
    </view>
  </view>
  <button class="edit-button" wx:if="{{profile}}" bindtap="editProfile">编辑个人资料</button>
  <view class="empty" wx:if="{{!profile}}">正在加载个人资料</view>
</view>
