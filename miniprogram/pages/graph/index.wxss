.graph { height: 500rpx; position: relative; overflow: hidden; background: #fafdff; }.center { position: absolute; left: 50%; top: 190rpx; transform: translateX(-50%); text-align: center; color: #163a63; font-size: 28rpx; font-weight: 650; z-index: 2; }.center-avatar,.node view { width: 102rpx; height: 102rpx; border-radius: 50%; display: flex; justify-content: center; align-items: center; background: #1677d2; color: #fff; font-size: 38rpx; margin-bottom: 10rpx; box-shadow: 0 8rpx 20rpx rgba(22,119,210,.25); }.node { position: absolute; top: 82rpx; text-align: center; color: #35536e; font-size: 25rpx; z-index: 2; }.node-left { left: 70rpx; }.node-right { right: 70rpx; }.node view { width: 82rpx; height: 82rpx; background: #65a9e3; font-size: 31rpx; }.line { position: absolute; top: 226rpx; width: 190rpx; height: 2rpx; background: #9ac6ea; }.line-left { left: 142rpx; transform: rotate(26deg); }.line-right { right: 142rpx; transform: rotate(-26deg); }.edge { display: flex; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid #edf0f4; font-size: 28rpx; }.edge:last-child { border: 0; }
