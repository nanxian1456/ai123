.graph-page { background:#f3f7fa; }.graph-hero { height:630rpx; position:relative; overflow:hidden; border-radius:17rpx; color:#fff; background:radial-gradient(circle at 50% 52%,#205d7b 0,#103650 43%,#0a1d34 100%); }.graph-title { position:relative; z-index:3; padding:34rpx 0 0 34rpx; font-size:34rpx; font-weight:700; }.graph-hero > text { position:relative; z-index:3; display:block; margin:8rpx 34rpx; color:#afd0df; font-size:22rpx; }.network { position:absolute; inset:0; }.orbit { position:absolute; left:50%; top:57%; border:1rpx solid rgba(102,224,211,.3); border-radius:50%; transform:translate(-50%,-50%); }.orbit-one { width:510rpx; height:340rpx; transform:translate(-50%,-50%) rotate(-22deg); }.orbit-two { width:310rpx; height:500rpx; transform:translate(-50%,-50%) rotate(22deg); border-color:rgba(130,182,255,.25); }.center-node,.graph-node { position:absolute; z-index:2; display:flex; flex-direction:column; align-items:center; text-align:center; }.center-node { left:50%; top:50%; transform:translate(-50%,-50%); color:#fff; font-size:25rpx; font-weight:700; }.center-node view { width:105rpx; height:105rpx; display:flex; align-items:center; justify-content:center; border:7rpx solid rgba(220,255,250,.7); border-radius:50%; color:#082737; background:#65ddd3; box-shadow:0 0 35rpx rgba(91,229,214,.75); font-size:39rpx; }.center-node text { margin-top:9rpx; }.graph-node { color:#e8fbff; font-size:22rpx; }.graph-node view { width:69rpx; height:69rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; color:#0d3450; background:#b8e9f7; box-shadow:0 0 24rpx rgba(144,213,244,.6); font-size:27rpx; font-weight:700; }.graph-node .relationship { margin-top:4rpx; padding:3rpx 8rpx; border-radius:7rpx; color:#c7fbf5; background:rgba(101,221,210,.18); font-size:18rpx; }.graph-node.top { left:50%; top:135rpx; transform:translateX(-50%); }.graph-node.right { right:54rpx; top:282rpx; }.graph-node.bottom { left:50%; bottom:35rpx; transform:translateX(-50%); }.graph-node.left { left:54rpx; top:282rpx; }.empty-graph { position:absolute; top:50%; left:0; right:0; color:#b5cadb; text-align:center; font-size:25rpx; }.section-head { display:flex; justify-content:space-between; align-items:center; margin:39rpx 4rpx 16rpx; }.section-head view { color:#17324e; font-size:32rpx; font-weight:700; }.section-head text { color:#8997a3; font-size:22rpx; }.edges { padding:0 25rpx; border-radius:14rpx; background:#fff; box-shadow:0 7rpx 22rpx rgba(19,58,99,.05); }.edges > view { display:flex; align-items:center; gap:13rpx; padding:22rpx 0; border-bottom:1rpx solid #edf1f3; color:#263d50; font-size:27rpx; }.edges > view:last-child { border:0; }.edge-icon { display:flex; align-items:center; justify-content:center; width:45rpx; height:45rpx; border-radius:50%; color:#1684c3; background:#e7f5ff; font-size:26rpx; }.edges text:last-child { margin-left:auto; color:#8d99a4; font-size:21rpx; }.empty { padding:50rpx 20rpx; border-radius:14rpx; background:#fff; color:#87949f; text-align:center; font-size:25rpx; }
