<view class="page graph-page"><settings-entry /><view class="graph-hero"><view class="graph-title">人物关系图谱</view><text>以联系人为中心，查看一层关系网络</text><view class="network" wx:if="{{center}}"><view class="orbit orbit-one"></view><view class="orbit orbit-two"></view><view class="center-node"><view>{{center.initial}}</view><text>{{center.name}}</text></view><view class="graph-node {{item.position}}" wx:for="{{related}}" wx:key="id" data-id="{{item.id}}" bindtap="contact"><view>{{item.initial}}</view><text>{{item.name}}</text><text class="relationship">{{item.relationship}}</text></view></view><view class="empty-graph" wx:else>正在加载关系网络</view></view><view class="section-head"><view>关系说明</view><text>{{edges.length}} 条关系</text></view><view class="edges" wx:if="{{edges.length}}"><view wx:for="{{edges}}" wx:key="id"><view class="edge-icon">⌘</view><text>{{item.type}}</text><text>关系已建立</text></view></view><view class="empty" wx:else>暂未建立关系，可从联系人详情中新增</view></view>
