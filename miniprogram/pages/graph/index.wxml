<view class="graph-page">
  <!-- 顶部工具条 -->
  <view class="toolbar-wrap">
    <view class="toolbar">
      <view class="search">
        <text class="search-icon">🔍</text>
        <input disabled="{{loading || loadError || canvasError}}" class="search-input" placeholder="{{mode === 'tree' ? '搜索联系人或分类' : '搜索联系人 / 单位 / 城市'}}" value="{{keyword}}" bindinput="onSearchInput" bindconfirm="search" confirm-type="search" />
        <text wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">×</text>
      </view>
      <view class="stats">
        <text class="pill">节点 {{nodeCount}}</text>
        <text class="pill">连线 {{edgeCount}}</text>
      </view>
    </view>
    <view class="search-results" wx:if="{{searchResults.length && !loading && !loadError && !canvasError}}">
      <scroll-view scroll-y class="search-results-body">
        <view class="search-result" wx:for="{{searchResults}}" wx:key="id" data-type="{{item.type}}" data-id="{{item.id}}" data-catid="{{item.catId}}" data-name="{{item.name}}" bindtap="locateResult">
          <view class="result-icon result-{{item.type}}">{{item.type === 'category' ? '分' : (item.type === 'contact' ? '联' : (item.type === 'org' ? '单' : (item.type === 'city' ? '城' : '人')))}}</view>
          <view class="result-main">
            <text class="result-name">{{item.name}}</text>
            <text class="result-sub">{{item.sub}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
    <view class="search-results search-empty" wx:elif="{{keyword && !loading && !loadError && !canvasError}}">
      <text>未找到「{{keyword}}」相关结果</text>
    </view>
  </view>

  <!-- 模式切换 + 模式相关操作 -->
  <view class="mode-switch">
    <view class="mode-tab {{mode === 'tree' ? 'on' : ''}}" data-mode="tree" bindtap="switchMode">标签树</view>
    <view class="mode-tab {{mode === 'network' ? 'on' : ''}}" data-mode="network" bindtap="switchMode">关系网</view>
    <view class="mode-actions">
      <button wx:if="{{mode === 'tree'}}" class="tool-btn" size="mini" bindtap="addTopCategory">+ 分类</button>
      <button wx:if="{{mode === 'tree'}}" class="tool-btn" size="mini" bindtap="openManage" aria-label="管理分类">管理分类</button>
      <block wx:else>
        <button class="tool-btn" size="mini" bindtap="openSheet" data-sheet="filter">筛选</button>
        <button class="tool-btn" size="mini" bindtap="openSheet" data-sheet="rank">排行</button>
        <button class="tool-btn" size="mini" bindtap="openSheet" data-sheet="tools">工具</button>
      </block>
    </view>
  </view>

  <!-- 画布 -->
  <view class="stage">
    <canvas type="2d" id="graph" class="graph-canvas" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd"></canvas>

    <view class="graph-feedback" wx:if="{{loading || loadError || canvasError}}" role="status">
      <view wx:if="{{loading}}">正在加载图谱…</view>
      <block wx:else><view>{{canvasError || loadError}}</view><button class="secondary-button" bindtap="retryGraph">重新加载图谱</button></block>
    </view>

    <!-- 顶部提示叠层：聚焦条 + 提示，纵向排列，互不遮挡 -->
    <view class="overlay-top">
      <view class="focus-banner" wx:if="{{focusedBranch}}">
        <text class="focus-text">已聚焦「{{focusedName}}」</text>
        <text class="focus-exit" bindtap="unfocusBranch">显示全部 ✕</text>
      </view>
      <view class="hint" wx:if="{{hint}}" bindtap="clearHint">{{hint}}</view>
    </view>

    <!-- 图例 -->
    <view class="legend" wx:if="{{mode === 'tree' || !empty}}">
      <view class="legend-item" wx:for="{{legend}}" wx:key="key">
        <view class="legend-dot" style="background:{{item.color}}"></view>
        <text>{{item.label}}</text>
      </view>
    </view>

    <!-- 顶部提示（已在 .overlay-top 中与聚焦条统一排布，此处不再单独渲染） -->

    <!-- 标签树 · 空数据引导（不遮挡画布，画布上仍有「我」与推荐分类） -->
    <view class="tree-tip" wx:if="{{mode === 'tree' && empty && !loading && !loadError && !canvasError}}">
      <view class="tree-tip-title">从「我」开始搭建你的人脉树</view>
      <view class="tree-tip-desc">双击画布上虚线的「+」推荐分类即可快速添加为分支，或点右上角「+ 分类」自定义（公司 / 大学 / 朋友…）。点「管理」可重命名、删除分类，或隐藏不想要的推荐分类。在联系人页添加联系人后，点分类「导入已有联系人」即可归入。<text class="tree-tip-hl">单击分支查看其联系人，双击分支可聚焦（隐藏其余分支），单击「我」退出聚焦。</text></view>
    </view>

    <!-- 关系网 · 空状态（网络模式无联系人不渲染） -->
    <view class="empty-state" wx:if="{{empty && mode === 'network' && !loading && !loadError && !canvasError}}">
      <view class="empty-card">
        <view class="empty-emoji">🕸️</view>
        <view class="empty-title">还没有人脉数据</view>
        <view class="empty-desc">关系网会根据你添加的「联系人」和「关系」自动生成。请先到联系人页添加联系人。</view>
        <button class="primary-button empty-cta" bindtap="goContacts">去联系人页</button>
      </view>
    </view>
  </view>

  <!-- 遮罩 -->
  <view class="sheet-mask" wx:if="{{sheet}}" bindtap="sheetMaskTap"></view>

  <!-- 抽屉：自我中心 -->
  <view class="sheet" wx:if="{{sheet === 'self'}}">
    <view class="sheet-head">
      <text class="sheet-title">{{sheetTitle}}</text>
      <text class="sheet-close" bindtap="closeSheet">×</text>
    </view>
    <scroll-view scroll-y class="sheet-body">
      <view class="detail-name">{{selected.label}}</view>
      <view class="detail-sub">这是你的人脉树中心</view>
      <view class="kv">
        <view class="kv-row"><text class="k">联系人</text><text class="v">{{selected.contactCount}} 位</text></view>
        <view class="kv-row"><text class="k">分类</text><text class="v">{{selected.categoryCount}} 个</text></view>
      </view>
      <view class="sheet-actions">
        <button class="primary-button" bindtap="addTopCategory">新建分类</button>
        <button class="secondary-button" bindtap="goContacts">查看全部联系人</button>
      </view>
    </scroll-view>
  </view>

  <!-- 抽屉：分支（分类）详情 -->
  <view class="sheet" wx:if="{{sheet === 'branch'}}">
    <view class="sheet-head">
      <text class="sheet-title">{{sheetTitle}}</text>
      <text class="sheet-close" bindtap="closeSheet">×</text>
    </view>
    <scroll-view scroll-y class="sheet-body">
      <view class="detail-name">{{selected.name}}{{selected.recommended ? '（推荐）' : ''}}{{selected.synthetic ? '（自动）' : ''}}</view>
      <view class="detail-sub">该分类下 {{selected.contacts.length}} 位联系人</view>

      <!-- 联系人 -->
      <view class="section-title">联系人（{{selected.contacts.length}}）</view>
      <view class="member" wx:for="{{selected.contacts}}" wx:key="id" data-id="{{item.id}}" bindtap="viewBranchContact">
        <text class="member-name">{{item.name}}</text>
        <text class="member-org">{{item.org}}</text>
        <text class="chevron">›</text>
      </view>
      <view class="empty" wx:if="{{!selected.contacts.length}}">{{selected.synthetic ? '所有联系人都已归类' : '暂无联系人，点下方按钮导入已有联系人'}}</view>

      <!-- 子分类 -->
      <view class="section-title" wx:if="{{selected.childCategories.length}}">子分类（{{selected.childCategories.length}}）</view>
      <view class="cat-item" wx:for="{{selected.childCategories}}" wx:key="id" data-id="{{item.id}}" bindtap="openChild">
        <view class="legend-dot" style="background:{{item.recommended ? '#9aa7b4' : '#2563eb'}}"></view>
        <text class="cat-name">{{item.name}}{{item.recommended ? '（推荐）' : ''}}</text>
        <text class="cat-count">{{item.contactCount}} 人</text>
        <text class="chevron">›</text>
      </view>

      <!-- 操作 -->
      <view class="sheet-actions">
        <block wx:if="{{selected.synthetic}}">
          <view class="sheet-note">「未分类」为自动汇总。打开具体分类，点「导入已有联系人」即可归类。</view>
        </block>
        <block wx:else>
          <button class="primary-button" data-id="{{selected.id}}" bindtap="openImport">导入已有联系人</button>
          <button class="secondary-button" data-id="{{selected.id}}" bindtap="addChildCategory">新建子分类</button>
          <button class="secondary-button" data-id="{{selected.id}}" bindtap="renameCategory">重命名</button>
          <button class="danger-button" data-id="{{selected.id}}" data-name="{{selected.name}}" bindtap="deleteCategory">删除分类</button>
        </block>
      </view>
    </scroll-view>
  </view>

  <!-- 抽屉：导入已有联系人到分类 -->
  <view class="sheet" wx:if="{{sheet === 'import'}}">
    <view class="sheet-head">
      <text class="sheet-title">{{sheetTitle}}</text>
      <text class="sheet-close" bindtap="closeSheet">×</text>
    </view>
    <view class="import-search">
      <input class="search-input" placeholder="搜索姓名、单位、职务或城市" value="{{importKeyword}}" bindinput="onImportKeyword" />
    </view>
    <scroll-view scroll-y class="sheet-body import-body">
      <view class="member" wx:for="{{importList}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleImport" aria-role="checkbox" aria-checked="{{item.checked}}">
        <view class="import-check {{item.checked ? 'import-check--on' : ''}}">{{item.checked ? '✓' : ''}}</view>
        <text class="member-name">{{item.name}}</text>
        <text class="member-org">{{item.org}}</text>
      </view>
      <view class="empty" wx:if="{{!importList.length}}">{{importTotal ? '没有符合条件的联系人' : '所有联系人都已在此分类中，可到联系人页新增联系人'}}</view>
    </scroll-view>
    <view class="sheet-actions import-actions">
      <button class="primary-button" bindtap="confirmImport" disabled="{{!importCount}}">导入{{importCount ? ' ' + importCount + ' 位' : ''}}</button>
      <button class="secondary-button" bindtap="backToBranch">返回分类</button>
    </view>
  </view>

  <!-- 抽屉：分类管理（增删改 · 推荐隐藏/恢复） -->
  <view class="sheet" wx:if="{{sheet === 'manage'}}">
    <view class="sheet-head">
      <text class="sheet-title">{{sheetTitle}}</text>
      <text class="sheet-close" bindtap="closeSheet">×</text>
    </view>
    <scroll-view scroll-y class="sheet-body">
      <view class="category-help">标签树按分类分组；联系人标签在联系人页管理，用于筛选。分类与标签不会自动互相转换。</view>
      <view class="section-title">我的分类（{{manageCategories.length}}）</view>
      <view class="manage-row" wx:for="{{manageCategories}}" wx:key="id">
        <view class="manage-info" style="padding-left:{{item.indent}}rpx">
          <view class="legend-dot" style="background:#2563eb"></view>
          <text class="manage-name">{{item.name}}</text>
          <text class="manage-count">{{item.contactCount}} 人</text>
        </view>
        <view class="manage-ops">
          <text class="op" data-id="{{item.id}}" bindtap="renameCategory">重命名</text>
          <text class="op danger" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="deleteCategory">删除</text>
        </view>
      </view>
      <view class="empty" wx:if="{{!manageCategories.length}}">还没有自定义分类，点上方「+ 分类」新建</view>

      <view class="section-title" wx:if="{{manageRecommended.length}}">推荐分类（{{manageRecommended.length}}）</view>
      <view class="manage-row" wx:for="{{manageRecommended}}" wx:key="*this">
        <view class="manage-info">
          <view class="legend-dot" style="background:#9aa7b4"></view>
          <text class="manage-name">{{item}}</text>
        </view>
        <view class="manage-ops">
          <text class="op" data-name="{{item}}" bindtap="addRecommendedCategory">添加</text>
          <text class="op danger" data-name="{{item}}" bindtap="dismissRecommended">隐藏</text>
        </view>
      </view>

      <view class="section-title" wx:if="{{manageDismissed.length}}">已隐藏的推荐（{{manageDismissed.length}}）</view>
      <view class="manage-row" wx:for="{{manageDismissed}}" wx:key="*this">
        <view class="manage-info">
          <view class="legend-dot" style="background:#cbd5e1"></view>
          <text class="manage-name manage-name--off">{{item}}</text>
        </view>
        <view class="manage-ops">
          <text class="op" data-name="{{item}}" bindtap="restoreRecommended">恢复</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 抽屉：节点 / 关系 / 路径 详情（关系网） -->
  <view class="sheet" wx:if="{{sheet === 'detail'}}">
    <view class="sheet-head">
      <text class="sheet-title">{{sheetTitle}}</text>
      <text class="sheet-close" bindtap="closeSheet">×</text>
    </view>
    <scroll-view scroll-y class="sheet-body">

      <!-- 人物节点（关系网 / 标签树联系人通用） -->
      <block wx:if="{{selected.type === 'node' && selected.kind === 'person'}}">
        <view class="detail-name">{{selected.label}}</view>
        <view class="detail-sub">{{selected.sub || '人脉节点'}} · 关联 {{selected.degree}}</view>
        <view class="kv" wx:if="{{selected.organization || selected.city}}">
          <view class="kv-row" wx:if="{{selected.organization}}"><text class="k">单位</text><text class="v">{{selected.organization}}</text></view>
          <view class="kv-row" wx:if="{{selected.city}}"><text class="k">城市</text><text class="v">{{selected.city}}</text></view>
        </view>
        <view class="tag-row" wx:if="{{selected.tags.length}}">
          <text class="tag" wx:for="{{selected.tags}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="sheet-actions">
          <button class="primary-button" bindtap="viewContact">查看联系人</button>
          <button class="secondary-button" bindtap="addRelation" wx:if="{{mode === 'network'}}">添加关系</button>
          <button class="secondary-button" bindtap="centerOn" wx:if="{{mode === 'network'}}">以 TA 为中心</button>
        </view>
      </block>

      <!-- 单位 / 城市 节点 -->
      <block wx:if="{{selected.type === 'node' && (selected.kind === 'org' || selected.kind === 'city')}}">
        <view class="detail-name">{{selected.label}}</view>
        <view class="detail-sub">{{selected.sub}} · 关联 {{selected.degree}} 人</view>
        <view class="section-title">成员（{{selected.members.length}}）</view>
        <view class="member" wx:for="{{selected.members}}" wx:key="id" data-id="{{item.id}}" bindtap="focusMember">
          <text class="member-name">{{item.label}}</text>
          <text class="member-org">{{item.org}}</text>
          <text class="chevron">›</text>
        </view>
        <view class="empty" wx:if="{{!selected.members.length}}">暂无成员</view>
      </block>

      <!-- 关系边 -->
      <block wx:if="{{selected.type === 'edge'}}">
        <view class="detail-name">{{selected.relType}}</view>
        <view class="detail-sub">{{selected.kind === 'relation' ? '关系' : '归属关系'}}</view>
        <view class="kv">
          <view class="kv-row"><text class="k">起点</text><text class="v">{{selected.sourceLabel}}</text></view>
          <view class="kv-row"><text class="k">终点</text><text class="v">{{selected.targetLabel}}</text></view>
          <view class="kv-row" wx:if="{{selected.note}}"><text class="k">备注</text><text class="v">{{selected.note}}</text></view>
        </view>
        <view class="sheet-actions" wx:if="{{selected.kind === 'relation'}}">
          <button class="danger-button" bindtap="deleteRelation">删除关系</button>
        </view>
      </block>

      <!-- 最短路径 -->
      <block wx:if="{{selected.type === 'path'}}">
        <view class="detail-sub">共 {{selected.path.length - 1}} 跳</view>
        <view class="path-chain">
          <text class="path-node" wx:for="{{selected.path}}" wx:key="id" data-id="{{item.id}}" bindtap="pathNodeTap">{{item.label}}<text class="path-arrow" wx:if="{{index < selected.path.length - 1}}"> → </text></text>
        </view>
      </block>

    </scroll-view>
  </view>

  <!-- 抽屉：筛选（仅关系网） -->
  <view class="sheet" wx:if="{{sheet === 'filter'}}">
    <view class="sheet-head">
      <text class="sheet-title">{{sheetTitle}}</text>
      <text class="sheet-close" bindtap="closeSheet">×</text>
    </view>
    <scroll-view scroll-y class="sheet-body">
      <view class="section-title">节点类型</view>
      <view class="filter-row" wx:for="{{legend}}" wx:key="key" data-kind="{{item.key}}" bindtap="toggleKind">
        <view class="legend-dot" style="background:{{item.color}}"></view>
        <text class="filter-name">{{item.label}}</text>
        <text class="filter-state {{filters[item.key] ? 'on' : 'off'}}">{{filters[item.key] ? '显示' : '隐藏'}}</text>
      </view>
      <view class="section-title" wx:if="{{relTypes.length}}">关系类型</view>
      <view class="filter-row" wx:for="{{relTypes}}" wx:key="name" data-type="{{item.name}}" bindtap="toggleRel">
        <view class="legend-dot" style="background:#9aa7b4"></view>
        <text class="filter-name">{{item.name}}</text>
        <text class="filter-state {{relFilter[item.name] === false ? 'off' : 'on'}}">{{relFilter[item.name] === false ? '隐藏' : '显示'}}</text>
      </view>
      <view class="empty" wx:if="{{!relTypes.length}}">暂无关系类型</view>
    </scroll-view>
  </view>

  <!-- 抽屉：中心度排行（仅关系网） -->
  <view class="sheet" wx:if="{{sheet === 'rank'}}">
    <view class="sheet-head">
      <text class="sheet-title">{{sheetTitle}}</text>
      <text class="sheet-close" bindtap="closeSheet">×</text>
    </view>
    <scroll-view scroll-y class="sheet-body">
      <view class="rank-item" wx:for="{{rankList}}" wx:key="id" data-id="{{item.id}}" bindtap="rankTap">
        <text class="rank-idx">{{item.rank}}</text>
        <view class="legend-dot" style="background:{{item.kind === 'person' ? '#2563eb' : (item.kind === 'org' ? '#18a88e' : '#d89134')}}"></view>
        <text class="rank-name">{{item.label}}</text>
        <text class="rank-degree">{{item.degree}} 度</text>
      </view>
      <view class="empty" wx:if="{{!rankList.length}}">暂无数据</view>
    </scroll-view>
  </view>

  <!-- 抽屉：工具（仅关系网） -->
  <view class="sheet" wx:if="{{sheet === 'tools'}}">
    <view class="sheet-head">
      <text class="sheet-title">{{sheetTitle}}</text>
      <text class="sheet-close" bindtap="closeSheet">×</text>
    </view>
    <scroll-view scroll-y class="sheet-body">
      <view class="tool-grid">
        <button class="tool-card" bindtap="fit">适合窗口</button>
        <button class="tool-card" bindtap="resetView">重置视图</button>
        <button class="tool-card" bindtap="toggleFreeze">{{frozen ? '继续布局' : '暂停布局'}}</button>
        <button class="tool-card" bindtap="togglePathMode">{{pathMode ? '退出路径' : '最短路径'}}</button>
      </view>

      <view class="section-title">N 度人脉隔离</view>
      <view class="degree-row">
        <text class="degree-opt {{degreeN === 1 ? 'on' : ''}}" data-n="1" bindtap="setDegreeN">1 度</text>
        <text class="degree-opt {{degreeN === 2 ? 'on' : ''}}" data-n="2" bindtap="setDegreeN">2 度</text>
        <text class="degree-opt {{degreeN === 3 ? 'on' : ''}}" data-n="3" bindtap="setDegreeN">3 度</text>
      </view>
      <view class="tool-grid">
        <button class="tool-card" bindtap="isolateN">隔离 {{degreeN}} 度</button>
        <button class="tool-card" bindtap="clearIsolation">清除隔离</button>
      </view>
      <view class="tool-tip">提示：先点选一个节点，再「隔离 N 度」可只看其 N 度内的人脉；「最短路径」下依次点选起点与终点即可高亮路径。</view>
    </scroll-view>
  </view>

</view>
