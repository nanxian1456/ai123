.home-page { padding-bottom:48rpx; }
.home-page .ui-title { font-size:40rpx; letter-spacing:-1rpx; }
.home-entry-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20rpx; margin:32rpx 0 24rpx; }
.home-entry { position:relative; min-width:0; margin:0; padding:28rpx; border-radius:24rpx; text-align:left; line-height:1.5; box-shadow:none; }
.home-entry::after,.home-tools button::after,.recent-person::after,.home-local-note::after { border:none; }
.home-entry--primary { background:var(--accent); color:#fff; }
.home-entry--ai { background:#eaf0ff; color:var(--ink); border:1rpx solid #dce6fb; }
.entry-symbol { width:64rpx; height:64rpx; display:flex; align-items:center; justify-content:center; margin-bottom:24rpx; background:rgba(255,255,255,.18); border-radius:18rpx; font-size:40rpx; line-height:1; }
.entry-symbol--ai { background:#fff; color:var(--accent); font-size:24rpx; font-weight:700; }
.entry-title { font-size:31rpx; font-weight:650; }
.entry-caption { margin-top:8rpx; font-size:23rpx; opacity:.78; }
.entry-arrow { position:absolute; right:24rpx; top:26rpx; font-size:30rpx; opacity:.7; }
.home-overview { display:flex; padding:24rpx 0; margin-bottom:24rpx; border-bottom:1rpx solid var(--line); }
.metric { flex:1; display:flex; flex-direction:column; text-align:center; border-right:1rpx solid var(--line); }
.metric:last-child { border:0; }
.metric-value { color:var(--ink); font-size:38rpx; font-weight:700; line-height:1.25; }
.metric-label { margin-top:8rpx; font-size:23rpx; color:var(--muted); }
.home-tools { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12rpx; }
.home-tools button { display:flex; align-items:center; gap:8rpx; margin:0; padding:20rpx 10rpx; min-width:0; background:#fff; border-radius:16rpx; font-size:23rpx; line-height:1.5; color:var(--ink); }
.tool-dot { flex:none; width:32rpx; height:32rpx; border-radius:9rpx; font-size:19rpx; background:var(--accent-soft); color:var(--accent); text-align:center; line-height:32rpx; }
.tool-chevron { margin-left:auto; color:#9aa6b2; }
.home-section-heading { display:flex; justify-content:space-between; align-items:center; gap:16rpx; margin:36rpx 0 18rpx; }
.recent-panel { background:#fff; padding:0 24rpx; border:1rpx solid var(--line); border-radius:22rpx; }
.recent-person { display:flex; align-items:center; gap:18rpx; padding:24rpx 0; margin:0; background:#fff; border-radius:0; border-bottom:1rpx solid var(--line-soft); text-align:left; line-height:1.5; }
.recent-person:last-child { border:0; }
.person-avatar { flex:none; display:flex; align-items:center; justify-content:center; width:76rpx; height:76rpx; border-radius:22rpx; color:var(--accent); background:var(--accent-soft); font-size:29rpx; font-weight:650; }
.person-content { flex:1; min-width:0; }
.person-name { color:var(--text); font-size:29rpx; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.person-meta { color:var(--muted); font-size:23rpx; margin-top:6rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.person-city { max-width:100rpx; color:var(--muted); font-size:23rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.person-chevron { color:#a4aeb8; font-size:32rpx; }
.home-empty { padding:36rpx 26rpx; border:1rpx dashed #ced9e9; border-radius:22rpx; text-align:center; font-size:29rpx; color:var(--ink); background:#fff; }
.home-empty > text { display:block; margin:10rpx 0 24rpx; color:var(--muted); font-size:24rpx; }
.empty-symbol { color:var(--accent); font-size:44rpx; }
.home-local-note { display:flex; align-items:center; justify-content:center; gap:10rpx; padding:26rpx 0 0; margin:0; color:var(--muted); background:none; font-size:21rpx; line-height:1.5; }
.local-note-dot { width:9rpx; height:9rpx; border-radius:50%; background:#5c9a8a; }
.home-page .home-entry-grid .home-entry { width:100%; max-width:100%; box-sizing:border-box; }
.home-entry,.home-tools button,.recent-person,.home-local-note { font-weight:400; }
.home-entry .entry-title,.home-entry .entry-caption { word-wrap:break-word; overflow-wrap:break-word; }
.home-page .home-tools button { width:100%; box-sizing:border-box; }
.home-tools button > text:nth-child(2) { flex:1; min-width:0; word-wrap:break-word; }
.home-tools .tool-chevron { flex:none; }
.home-page button.recent-person:not([size="mini"]) { width:100%; min-width:0; box-sizing:border-box; }
.home-section-heading { flex-wrap:wrap; }
.home-overview .metric { flex:1 1 0%; min-width:0; padding:0 8rpx; box-sizing:border-box; }
.metric-value,.metric-label { max-width:100%; word-wrap:break-word; }
.home-page .home-local-note { width:100%; }
.home-local-note > text:nth-child(2) { min-width:0; white-space:normal; }
.home-local-note > text:first-child,.home-local-note > text:last-child { flex:none; }
@media (max-width:360px) {
  .home-entry { padding:22rpx 18rpx; }
  .home-tools { grid-template-columns:1fr; }
}
.home-local-note--warn { margin-top:20rpx; padding:20rpx 24rpx; border-radius:16rpx; background:#fff6e5; color:#9a5b00; font-size:23rpx; }
.home-local-note--warn .local-note-dot { background:#d97706; }
