.hero { background: #12365f; color: #fff; padding: 40rpx 34rpx; border-radius: 18rpx; }.eyebrow { font-size: 20rpx; opacity: .72; letter-spacing: 2rpx; }.hero-title { font-size: 48rpx; font-weight: 700; margin: 14rpx 0; }.hero-text { font-size: 26rpx; opacity: .86; }
.stats { display: flex; background: #fff; margin: 20rpx 0; padding: 24rpx 0; border-radius: 16rpx; box-shadow: 0 8rpx 28rpx rgba(19,58,99,.06); }.stat { flex: 1; text-align: center; color: #7a8494; font-size: 24rpx; border-right: 1rpx solid #edf0f4; }.stat:last-child { border: 0; }.num { display: block; color: #163a63; font-size: 40rpx; font-weight: 700; margin-bottom: 4rpx; }
.status-card { color: #63809f; font-size: 25rpx; padding: 12rpx 4rpx; }.status-card.error { color: #c95e56; }.section-head { margin: 35rpx 0 18rpx; }.section-title { color: #173b64; font-size: 32rpx; font-weight: 700; }.section-subtitle { color: #8694a5; font-size: 23rpx; margin-top: 8rpx; }
.featured-action { display: flex; align-items: center; background: #e7f5ff; border: 1rpx solid #b9e2fc; border-radius: 14rpx; padding: 25rpx 22rpx; }.feature-icon { flex: 0 0 auto; width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; color: #fff; font-size: 26rpx; font-weight: 700; background: #1686d9; }.feature-copy { flex: 1; margin-left: 18rpx; }.feature-title { color: #135b94; font-size: 29rpx; font-weight: 700; }.feature-text { color: #537a9a; font-size: 23rpx; margin-top: 6rpx; line-height: 1.5; }.arrow { color: #1686d9; font-size: 46rpx; margin-left: 14rpx; }
.actions { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 16rpx; }.action { height: 136rpx; background: #fff; border-radius: 14rpx; display: flex; flex-direction: column; justify-content: center; align-items: center; font-size: 26rpx; color: #24486d; box-shadow: 0 7rpx 22rpx rgba(19,58,99,.06); }.action.primary { background: #eaf3ff; color: #1677d2; }.action-icon { font-size: 40rpx; line-height: 46rpx; font-weight: 500; }
.recent-title { margin: 38rpx 0 18rpx; }.contact-row { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #eef1f4; }.contact-row:last-child { border: 0; }.avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: #d9ecff; color: #1677d2; display: flex; align-items: center; justify-content: center; font-weight: 700; }.contact-main { flex: 1; margin-left: 18rpx; }.contact-name { font-size: 30rpx; font-weight: 600; margin-bottom: 6rpx; }.city { font-size: 24rpx; color: #5e7996; }.empty-recent { color: #8a98a8; font-size: 25rpx; background: #fff; border-radius: 12rpx; padding: 34rpx; text-align: center; }
.hero { position:relative; }.settings-button { position:absolute; top:24rpx; left:24rpx; padding:8rpx 14rpx; border:1rpx solid rgba(255,255,255,.35); border-radius:8rpx; color:#fff; font-size:22rpx; }.eyebrow { margin-left:104rpx; }
