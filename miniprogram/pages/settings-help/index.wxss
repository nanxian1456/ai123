.help-page .card { margin-bottom:24rpx; }
.faq { margin-top:26rpx; padding-bottom:22rpx; border-bottom:1rpx solid var(--line-soft); min-width:0; }
.faq:last-child { border-bottom:0; padding-bottom:0; }
.faq-question { color:var(--ink); font-size:27rpx; line-height:1.6; font-weight:600; }
.faq > text { display:block; margin-top:10rpx; color:var(--muted); font-size:24rpx; line-height:1.8; white-space:pre-wrap; overflow-wrap:anywhere; }
.feedback-button { margin-top:20rpx; }
