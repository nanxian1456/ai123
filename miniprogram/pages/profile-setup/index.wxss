.profile-intro { margin:14rpx 4rpx 27rpx; }.profile-intro .step { color:#169b86; font-size:22rpx; font-weight:600; }.profile-intro view:nth-child(2) { margin-top:10rpx; color:#17324e; font-size:37rpx; font-weight:700; }.profile-intro text { display:block; margin-top:9rpx; color:#8593a2; font-size:23rpx; }.avatar-preview,.option-avatar { position:relative; overflow:hidden; border-radius:50%; }.avatar-preview { width:105rpx; height:105rpx; margin:8rpx auto 18rpx; border:6rpx solid #d9f3ef; }.avatar-head { position:absolute; z-index:1; left:50%; top:23%; width:35%; height:35%; transform:translateX(-50%); border-radius:50%; background:#f7d2b8; }.avatar-body { position:absolute; left:50%; bottom:-5%; width:74%; height:46%; transform:translateX(-50%); border-radius:48% 48% 0 0; }.avatar-male-1 { background:#d9ecff; }.avatar-male-1 .avatar-body { background:#287fcb; }.avatar-male-2 { background:#e4e8ff; }.avatar-male-2 .avatar-body { background:#465bb6; }.avatar-female-1 { background:#ffe3ee; }.avatar-female-1 .avatar-head { top:20%; width:42%; height:42%; background:#f3c1ad; }.avatar-female-1 .avatar-body { background:#e67ba7; }.avatar-female-2 { background:#f2e4ff; }.avatar-female-2 .avatar-head { top:20%; width:42%; height:42%; background:#f0c4a9; }.avatar-female-2 .avatar-body { background:#8a62b7; }.avatar-picker { margin:0 0 24rpx; }.picker-label { margin:0 0 15rpx 4rpx; color:#53687a; font-size:25rpx; }.avatar-options { display:flex; justify-content:space-between; gap:12rpx; }.avatar-option { flex:1; padding:12rpx 3rpx 10rpx; border:2rpx solid transparent; border-radius:12rpx; text-align:center; }.avatar-option.selected { border-color:#1684c3; background:#edf7ff; }.option-avatar { width:72rpx; height:72rpx; margin:0 auto 7rpx; }.avatar-option text { color:#607283; font-size:20rpx; }.avatar-option.selected text { color:#1474ad; font-weight:600; }.form-card { padding:0 25rpx; border-radius:14rpx; background:#fff; box-shadow:0 7rpx 22rpx rgba(19,58,99,.05); }.field { min-height:96rpx; display:flex; align-items:center; border-bottom:1rpx solid #edf1f3; }.field:last-child { border:0; }.field > text { width:158rpx; color:#53687a; font-size:27rpx; }.field input { flex:1; color:#20394d; font-size:27rpx; }.field.bio { align-items:flex-start; padding:24rpx 0; }.field textarea { flex:1; height:142rpx; color:#20394d; font-size:26rpx; }.save-button { height:96rpx; display:flex; align-items:center; justify-content:center; margin-top:33rpx; border-radius:12rpx; color:#fff; background:#1684c3; font-size:30rpx; font-weight:600; }
