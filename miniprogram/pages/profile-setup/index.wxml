<view class="page"><view class="profile-intro"><view class="step">{{isEdit ? '编辑资料' : '注册完成'}}</view><view>{{isEdit ? '更新你的个人信息' : '完善个人资料，开始建立人脉网络'}}</view><text>以下资料仅用于你的个人主页展示</text></view><view class="avatar-preview">{{form.nickname ? form.nickname.charAt(0) : '我'}}</view><view class="form-card"><view class="field"><text>昵称 *</text><input data-field="nickname" value="{{form.nickname}}" bindinput="input" placeholder="请输入昵称" maxlength="30"/></view><view class="field"><text>单位</text><input data-field="organization" value="{{form.organization}}" bindinput="input" placeholder="学校、公司或机构" maxlength="60"/></view><view class="field"><text>职务</text><input data-field="position" value="{{form.position}}" bindinput="input" placeholder="例如：教授、产品经理" maxlength="40"/></view><view class="field"><text>城市</text><input data-field="city" value="{{form.city}}" bindinput="input" placeholder="所在城市" maxlength="30"/></view><view class="field bio"><text>个人简介</text><textarea data-field="bio" value="{{form.bio}}" bindinput="input" placeholder="用一句话介绍自己" maxlength="200"/></view></view><view class="save-button" bindtap="save">{{saving ? '正在保存...' : (isEdit ? '保存修改' : '进入 AI 人脉地图') }}</view></view>
