<view class="page">
  <view class="privacy-intro">新用户默认所有资料均不公开。公开昵称后，持有你的导入码的人可以获取你选择公开的文字资料。头像仅保存在本机。</view>
  <view wx:if="{{profile.publicationStatus === 'pending' || profile.publicationStatus === 'error'}}" role="status">公开状态尚未确认，请联网重试同步。<button bindtap="retryPublication" loading="{{savingVisibility}}" disabled="{{savingVisibility}}">重试同步</button></view>
  <view class="card visibility-card" wx:if="{{profile}}">
    <view class="visibility-row" wx:for="{{visibilityItems}}" wx:key="field">
      <view><text>{{item.label}}</text><text>{{savingVisibility || profile.publicationStatus === 'pending' || profile.publicationStatus === 'error' ? '同步待确认' : (item.enabled ? '已公开' : '未公开')}}</text></view>
      <switch checked="{{item.enabled}}" color="#1684c3" data-field="{{item.field}}" bindchange="changeVisibility" disabled="{{savingVisibility}}"/>
    </view>
  </view>
  <view class="empty" wx:if="{{!profile}}">正在加载隐私设置</view>
  <view class="section-title">协议与授权</view>
  <view class="card consent-card">
    <view class="consent-row" bindtap="openTerms"><text>用户协议</text><text class="chevron">›</text></view>
    <view class="consent-row" bindtap="openPolicy"><text>隐私政策</text><text class="chevron">›</text></view>
    <view class="consent-row" bindtap="openWechatGuide"><text>小程序隐私保护指引</text><text class="chevron">›</text></view>
    <view class="consent-row">
      <view><text>AI 智能整理授权</text><text class="consent-sub">{{aiConsent ? '已同意向 DeepSeek 发送粘贴的文字' : '未授权，使用时会单独询问'}}</text></view>
      <button wx:if="{{aiConsent}}" class="consent-button" size="mini" bindtap="withdrawAi">撤回</button>
    </view>
    <view class="consent-row danger" bindtap="withdrawAll"><text>撤回全部同意并退出登录</text><text class="chevron">›</text></view>
  </view>
</view>
