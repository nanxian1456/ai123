<view class="page"><view class="me-hero" wx:if="{{profile}}"><view class="avatar">{{profile.nickname ? profile.nickname.charAt(0) : '我'}}</view><view class="main"><view>{{profile.nickname || '未设置昵称'}}</view><text>{{profile.position || '完善个人资料后展示职务'}}</text><text>{{profile.organization || '暂未填写单位'}}</text></view><view class="edit" bindtap="edit">编辑</view></view><view class="section-title">我的资料</view><view class="card details" wx:if="{{profile}}"><view><text>单位</text><text>{{profile.organization || '未填写'}}</text></view><view><text>职务</text><text>{{profile.position || '未填写'}}</text></view><view><text>城市</text><text>{{profile.city || '未填写'}}</text></view><view><text>个人简介</text><text>{{profile.bio || '未填写'}}</text></view></view><view class="section-title">账号与隐私</view><view class="card notice"><text>✓</text><view><view>个人数据已隔离</view><text>你的联系人、关系和资料仅对当前微信账号可见</text></view></view><view class="empty" wx:if="{{!profile}}">正在加载个人资料</view></view>
