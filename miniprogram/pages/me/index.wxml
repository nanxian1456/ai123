<view class="page"><view class="me-hero" wx:if="{{profile}}"><view class="avatar-wrap" bindtap="changeAvatar"><image wx:if="{{profile.avatarUrl}}" class="avatar-image" src="{{profile.avatarUrl}}" mode="aspectFill"/><view wx:else class="avatar avatar-{{profile.avatarType || 'male-1'}}"><view class="avatar-head"></view><view class="avatar-body"></view></view><view class="avatar-action">{{uploading ? '上传中' : '更换'}}</view></view><view class="main"><view>{{profile.nickname || '未设置昵称'}}</view><text>{{profile.position || '完善个人资料后展示职务'}}</text><text>{{profile.organization || '暂未填写单位'}}</text></view><view class="edit" bindtap="edit">编辑</view></view><view class="section-title">导入联系人</view><view class="card import-code" wx:if="{{profile}}"><view><text>我的导入码</text><text>让对方在新增联系人页输入此码</text></view><view class="code" bindtap="copyContactCode">{{profile.contactCode}}</view></view><view class="section-title">我的资料</view><view class="card details" wx:if="{{profile}}"><view><text>单位</text><text>{{profile.organization || '未填写'}}</text></view><view><text>职务</text><text>{{profile.position || '未填写'}}</text></view><view><text>城市</text><text>{{profile.city || '未填写'}}</text></view><view><text>个人简介</text><text>{{profile.bio || '未填写'}}</text></view></view><view class="section-title">资料公开设置</view><view class="card visibility-card" wx:if="{{profile}}"><view class="visibility-tip">新用户默认全部不公开，开启后将在后续公开资料功能中展示。</view><view class="visibility-row" wx:for="{{visibilityItems}}" wx:key="field"><text>{{item.label}}</text><switch checked="{{item.enabled}}" color="#1684c3" data-field="{{item.field}}" bindchange="changeVisibility" disabled="{{savingVisibility}}"/></view></view><view class="section-title">账号与隐私</view><view class="card notice"><text>✓</text><view><view>个人数据已隔离</view><text>你的联系人、关系和资料仅对当前微信账号可见</text></view></view><view class="empty" wx:if="{{!profile}}">正在加载个人资料</view></view>
