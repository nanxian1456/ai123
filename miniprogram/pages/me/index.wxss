.avatar-wrap { position:relative; width:118rpx; height:118rpx; flex:0 0 118rpx; }
.avatar,.avatar-image { width:106rpx; height:106rpx; overflow:hidden; border:6rpx solid rgba(218,255,250,.62); border-radius:50%; }
.avatar { position:relative; }
.avatar-image { display:block; background:#d9ecff; }
.avatar-head { position:absolute; z-index:1; left:50%; top:23%; width:35%; height:35%; transform:translateX(-50%); border-radius:50%; background:#f7d2b8; }
.avatar-body { position:absolute; left:50%; bottom:-5%; width:74%; height:46%; transform:translateX(-50%); border-radius:48% 48% 0 0; }
.avatar-male-1 { background:#d9ecff; }
.avatar-male-1 .avatar-body { background:#287fcb; }
.avatar-male-2 { background:#e4e8ff; }
.avatar-male-2 .avatar-body { background:#465bb6; }
.avatar-female-1 { background:#ffe3ee; }
.avatar-female-1 .avatar-head { top:20%; width:42%; height:42%; background:#f3c1ad; }
.avatar-female-1 .avatar-body { background:#e67ba7; }
.avatar-female-2 { background:#f2e4ff; }
.avatar-female-2 .avatar-head { top:20%; width:42%; height:42%; background:#f0c4a9; }
.avatar-female-2 .avatar-body { background:#8a62b7; }
.avatar-action { position:absolute; right:0; bottom:0; z-index:2; min-width:44rpx; padding:4rpx 7rpx; border-radius:8rpx; color:#fff; background:rgba(7,38,68,.75); text-align:center; font-size:18rpx; }
.account-page { padding-bottom:50rpx; }
.account-hero { display:flex; align-items:center; gap:20rpx; padding:12rpx 0 28rpx; }
.account-hero .avatar,.account-hero .avatar-image { border-color:#fff; box-shadow:0 5rpx 20rpx rgba(25,42,70,.08); }
.account-hero .avatar-action { background:var(--accent); border-radius:9rpx; }
.account-identity { flex:1; min-width:0; }
.account-identity > view { font-size:38rpx; font-weight:700; color:var(--ink); overflow-wrap:anywhere; }
.account-identity > text { display:block; margin-top:6rpx; color:var(--muted); font-size:24rpx; overflow-wrap:anywhere; }
.account-hero .ui-link { align-self:flex-start; margin-top:12rpx; }
.account-setup { display:flex; align-items:center; gap:14rpx; padding:20rpx 22rpx; margin-bottom:22rpx; border-radius:16rpx; background:#fff6e6; border:1rpx solid #f0e3c6; }
.account-setup > view { flex:1; min-width:0; }
.account-setup > view > view { color:#81581b; font-size:25rpx; font-weight:600; }
.account-setup text { display:block; margin-top:6rpx; color:#957a51; font-size:22rpx; }
.account-setup .ui-link { color:#81581b; }
.account-storage { border:1rpx solid #dce6fb; padding:26rpx; border-radius:22rpx; background:#fff; }
.storage-heading { display:flex; align-items:center; gap:18rpx; margin-bottom:24rpx; }
.storage-icon { flex:none; display:flex; align-items:center; justify-content:center; width:68rpx; height:68rpx; border-radius:18rpx; background:var(--accent-soft); color:var(--accent); font-size:27rpx; }
.storage-heading .ui-panel-title { font-size:28rpx; }
.storage-heading text { display:block; color:var(--muted); font-size:22rpx; margin-top:7rpx; }
.account-storage .ui-secondary { padding:18rpx; min-height:78rpx; font-size:26rpx; }
.account-section-title { margin:32rpx 0 18rpx; }
.account-tools { padding:0 24rpx; border:1rpx solid var(--line); border-radius:22rpx; background:#fff; }
.account-tool { display:flex; align-items:center; gap:18rpx; width:100%; margin:0; padding:25rpx 0; border-bottom:1rpx solid var(--line-soft); border-radius:0; background:none; text-align:left; line-height:1.5; }
.account-tool:last-child { border:0; }
.account-tool::after { border:none; }
.account-tool-icon { flex:none; width:62rpx; height:62rpx; display:flex; align-items:center; justify-content:center; border-radius:16rpx; background:#f2f5f9; color:#657d98; font-size:25rpx; }
.account-tool > view:nth-child(2) { flex:1; min-width:0; }
.account-tool > view:nth-child(2) > view { font-size:28rpx; color:var(--ink); font-weight:600; }
.account-tool > view:nth-child(2) > text { display:block; margin-top:7rpx; color:var(--muted); font-size:22rpx; }
.account-chevron { color:#a4aeb8; font-size:33rpx; }
.account-bio { padding:26rpx; margin-top:22rpx; background:#fff; border:1rpx solid var(--line); border-radius:20rpx; }
.account-bio > text { display:block; margin-top:14rpx; font-size:26rpx; color:#627187; line-height:1.8; white-space:pre-wrap; overflow-wrap:anywhere; }
.account-page .account-storage,.account-page .account-tools,.account-page .account-bio,.account-page .account-setup { box-sizing:border-box; min-width:0; max-width:100%; }
.account-page button.account-tool:not([size="mini"]) { width:100%; box-sizing:border-box; }
.account-tool { font-weight:400; }
.account-identity > view,.account-identity > text,.account-tool > view:nth-child(2),.account-bio > text { word-wrap:break-word; overflow-wrap:break-word; }
.storage-heading > view:last-child { flex:1; min-width:0; word-wrap:break-word; }
.account-hero .ui-link,.account-setup .ui-link { flex:none; width:auto; }
.account-chevron { flex:none; }
.account-setup > view,.account-tool > view:nth-child(2) > text { word-wrap:break-word; }
.account-page button.avatar-wrap:not([size="mini"]) { width:118rpx; height:118rpx; min-width:118rpx; margin:0; padding:0; background:transparent; border:0; border-radius:50%; overflow:visible; }
.avatar-wrap::after { border:0; }
.avatar-confirm { margin:20rpx 0; min-width:0; }
.avatar-preview-image { display:block; width:180rpx; height:180rpx; margin:24rpx auto; border-radius:24rpx; }
.avatar-confirm-actions { display:flex; gap:16rpx; }
.account-page .avatar-confirm-actions button { flex:1 1 0%; min-width:0; }
/* Keep frequent actions visible while allowing capacity details to expand on demand. */
.account-counts { display:flex; margin:0 0 22rpx; padding:22rpx 0; border-top:1rpx solid var(--line-soft); border-bottom:1rpx solid var(--line-soft); }
.account-counts > view { flex:1 1 0%; min-width:0; padding:0 12rpx; text-align:center; }
.account-counts > view + view { border-left:1rpx solid var(--line-soft); }
.account-count-value,.account-count-label { display:block; word-wrap:break-word; }
.account-count-value { font-size:38rpx; font-weight:700; line-height:1.3; color:var(--ink); }
.account-count-label { margin-top:7rpx; font-size:23rpx; color:var(--muted); }
.account-backup-time { color:var(--muted); font-size:23rpx; line-height:1.6; word-wrap:break-word; }
.account-page button.storage-toggle:not([size="mini"]) { width:auto; margin:6rpx 0 12rpx; padding:10rpx 0; background:none; color:var(--accent); text-align:left; font-size:23rpx; line-height:1.5; font-weight:400; border-radius:0; }
.storage-toggle::after { border:0; }
.storage-details { margin:0 0 20rpx; padding:18rpx; background:var(--accent-soft); border-radius:12rpx; color:var(--muted); font-size:22rpx; line-height:1.7; word-wrap:break-word; }
.account-settings { margin-top:22rpx; min-width:0; }
