<view class="auth-page">
  <view class="auth-bg">
    <video wx:if="{{bgVideo}}" class="bg-video" src="{{bgVideo}}" binderror="onVideoError" autoplay="{{true}}" loop="{{true}}" muted="{{true}}" show-center-play-btn="{{false}}" show-play-btn="{{false}}" controls="{{false}}" object-fit="cover"></video>
    <view class="bg-overlay"></view>
    <view class="glow glow-1"></view>
    <view class="glow glow-2"></view>
    <view class="grid"></view>
  </view>

  <view class="auth-body">
    <view class="title">欢迎来到 AI 人脉地图</view>
    <view class="subtitle">用更清晰的方式，记录每一次重要连接</view>

    <view class="hero-image-wrap">
      <image class="hero-image" src="/assets/images/hero-network.jpg" mode="aspectFill" />
    </view>

    <view class="benefit-modules">
      <view class="benefit-card card-left">
        <view class="card-glass"></view>
        <view class="card-content">
          <view class="check-mark">✓</view>
          <view class="card-title">安全的个人空间</view>
          <view class="card-desc">联系人默认只存在本机</view>
        </view>
      </view>
      <view class="benefit-card card-right">
        <view class="card-glass"></view>
        <view class="card-content">
          <view class="check-mark">✓</view>
          <view class="card-title">微信快捷登录</view>
          <view class="card-desc">首次登录完成资料即可使用</view>
        </view>
      </view>
    </view>
  </view>

  <view class="login-area">
    <view class="login-button {{loggingIn || !agreed ? 'disabled' : ''}}" bindtap="login">
      <text wx:if="{{!loggingIn}}">微信一键登录</text>
      <text wx:else>正在登录...</text>
      <text class="arrow">›</text>
    </view>
    <view class="agreement">
      <view class="agree-box {{agreed ? 'checked' : ''}}" bindtap="toggleAgree" role="checkbox" aria-checked="{{agreed}}" aria-label="同意用户协议和隐私政策">{{agreed ? '✓' : ''}}</view>
      <text bindtap="toggleAgree">我已阅读并同意</text><text class="agreement-link" bindtap="openTerms">《用户协议》</text><text>和</text><text class="agreement-link" bindtap="openPrivacy">《隐私政策》</text><text>，并以微信身份创建应用账号</text>
    </view>
  </view>
</view>
