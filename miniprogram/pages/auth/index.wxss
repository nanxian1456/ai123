.auth-page { min-height:100vh; padding:88rpx 46rpx 48rpx; background:#f5f8fc; }.hero-mark { display:flex; justify-content:center; }.rings { width:184rpx; height:184rpx; position:relative; display:flex; align-items:center; justify-content:center; border-radius:50%; background:#e2f4ff; }.rings view { position:absolute; border:2rpx solid rgba(31,140,210,.3); border-radius:50%; }.rings view:nth-child(1) { width:156rpx; height:156rpx; }.rings view:nth-child(2) { width:116rpx; height:116rpx; }.rings view:nth-child(3) { width:76rpx; height:76rpx; }.rings text { width:58rpx; height:58rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; color:#fff; background:#1677d2; font-size:26rpx; font-weight:700; }.title { margin-top:49rpx; color:#12365f; text-align:center; font-size:42rpx; font-weight:700; }.subtitle { margin-top:16rpx; color:#74869a; text-align:center; font-size:26rpx; line-height:1.6; }.benefits { margin-top:60rpx; padding:8rpx 24rpx; border-radius:15rpx; background:#fff; box-shadow:0 7rpx 25rpx rgba(20,61,99,.06); }.benefits > view { display:flex; gap:17rpx; padding:25rpx 0; border-bottom:1rpx solid #edf1f4; }.benefits > view:last-child { border:0; }.benefits > text { width:36rpx; height:36rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; color:#fff; background:#19a890; font-size:22rpx; }.benefits view view { color:#243c54; font-size:27rpx; font-weight:600; }.benefits view text { display:block; margin-top:7rpx; color:#8593a2; font-size:21rpx; font-weight:400; }.login-button { display:flex; align-items:center; justify-content:center; gap:17rpx; height:100rpx; margin-top:46rpx; border-radius:13rpx; color:#fff; background:#16a085; font-size:31rpx; font-weight:600; box-shadow:0 12rpx 25rpx rgba(22,160,133,.22); }.login-button text:last-child { font-size:43rpx; font-weight:300; }.login-button.disabled { opacity:.65; }.agreement { margin:23rpx 18rpx 0; color:#9aa5b1; text-align:center; font-size:20rpx; line-height:1.6; }
