.auth-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: #fff;
}

.auth-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  background: #051b3a;
  pointer-events: none;
}

.bg-video {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.bg-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(165deg, rgba(5,27,58,0.72) 0%, rgba(10,59,110,0.66) 40%, rgba(22,119,210,0.62) 100%);
}

.glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(120rpx);
  opacity: 0.45;
}

.glow-1 {
  width: 600rpx;
  height: 600rpx;
  top: -160rpx;
  right: -180rpx;
  background: radial-gradient(circle, #4fc3f7 0%, transparent 70%);
}

.glow-2 {
  width: 520rpx;
  height: 520rpx;
  bottom: -120rpx;
  left: -140rpx;
  background: radial-gradient(circle, #29b6f6 0%, transparent 70%);
}

.grid {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: 0.08;
  background-image:
    linear-gradient(rgba(255,255,255,0.35) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255,255,255,0.35) 1rpx, transparent 1rpx);
  background-size: 60rpx 60rpx;
}

.auth-body {
  position: relative;
  z-index: 1;
  padding: 88rpx 46rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  color: #fff;
  text-align: center;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 18rpx rgba(0,30,80,0.35);
}

.subtitle {
  margin-top: 14rpx;
  color: rgba(255,255,255,0.78);
  text-align: center;
  font-size: 25rpx;
  line-height: 1.5;
}

.hero-image-wrap {
  margin-top: 32rpx;
  width: 100%;
  height: 360rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.hero-image {
  width: 72%;
  max-width: 480rpx;
  height: 360rpx;
  border-radius: 24rpx;
  box-shadow: 0 24rpx 56rpx rgba(0,30,80,0.35), 0 0 0 1rpx rgba(255,255,255,0.08);
}

.benefit-modules {
  margin-top: 200rpx;
  width: 100%;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.benefit-card {
  position: relative;
  flex: 1;
  min-width: 0;
  padding: 30rpx 18rpx;
  border-radius: 20rpx;
  transform-style: preserve-3d;
  box-shadow: 0 16rpx 36rpx rgba(0,20,60,0.3);
}

.card-glass {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.18) 0%, rgba(255,255,255,0.06) 100%);
  border: 1rpx solid rgba(255,255,255,0.25);
  z-index: 0;
}

.card-left, .card-right {
  transform: perspective(900rpx) rotateY(0deg);
}

.card-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.check-mark {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #0a3b6e;
  background: #82eae1;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 18rpx rgba(130,234,225,0.35);
}

.card-title {
  margin-top: 16rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
}

.card-desc {
  margin-top: 8rpx;
  color: rgba(255,255,255,0.7);
  font-size: 21rpx;
  line-height: 1.4;
}

.login-area {
  position: absolute;
  left: 46rpx;
  right: 46rpx;
  top: 74vh;
  z-index: 2;
}

.login-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 17rpx;
  height: 100rpx;
  border-radius: 54rpx;
  color: #0a3b6e;
  background: linear-gradient(135deg, #ffffff 0%, #e2f4ff 100%);
  font-size: 31rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 40rpx rgba(0,40,90,0.35), inset 0 0 0 1rpx rgba(255,255,255,0.6);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.login-button:active {
  transform: scale(0.97);
  box-shadow: 0 10rpx 28rpx rgba(0,40,90,0.28);
}

.login-button.disabled {
  opacity: 0.65;
}

.arrow {
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
  color: #1677d2;
}

.agreement {
  margin-top: 18rpx;
  color: rgba(255,255,255,0.55);
  text-align: center;
  font-size: 19rpx;
  line-height: 1.5;
}
