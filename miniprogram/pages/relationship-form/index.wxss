.flow { display:flex; align-items:center; justify-content:center; gap:14rpx; margin:19rpx 0 32rpx; }.flow-step { width:39rpx; height:39rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; color:#8b98a4; background:#e7edf1; font-size:21rpx; }.flow-step.active { color:#fff; background:#1684c3; }.flow > view:not(.flow-step) { width:82rpx; height:2rpx; background:#dce5e9; }.intro { margin:0 5rpx 29rpx; }.intro view { color:#17324f; font-size:37rpx; font-weight:700; }.intro text { display:block; margin-top:9rpx; color:#85929e; font-size:24rpx; }.source-card { padding:29rpx; border-radius:14rpx; color:#fff; background:#12365f; }.source-card text:first-child { color:#9ed4ee; font-size:22rpx; }.source-card view { margin-top:11rpx; font-size:37rpx; font-weight:700; }.source-card text:last-child { display:block; margin-top:8rpx; opacity:.82; font-size:24rpx; }.section-title { margin:37rpx 4rpx 16rpx; color:#18314e; font-size:32rpx; font-weight:700; }.form-card { padding:0 25rpx; border-radius:14rpx; background:#fff; box-shadow:0 7rpx 22rpx rgba(19,58,99,.05); }.field { min-height:99rpx; display:flex; align-items:center; border-bottom:1rpx solid #edf1f3; }.field:last-child { border:0; }.field > text { width:160rpx; color:#53687a; font-size:27rpx; }.field picker { flex:1; }.field picker view { display:flex; justify-content:flex-end; color:#22394d; font-size:27rpx; }.field picker text { margin-left:15rpx; color:#1684c3; font-size:36rpx; }.field.note { align-items:flex-start; padding:24rpx 0; }.field textarea { flex:1; height:145rpx; font-size:26rpx; }.save-button { height:96rpx; display:flex; align-items:center; justify-content:center; gap:14rpx; margin-top:32rpx; border-radius:12rpx; color:#fff; background:#1684c3; font-size:30rpx; font-weight:600; }.save-button text:first-child { font-size:38rpx; }
