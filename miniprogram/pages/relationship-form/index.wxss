.caption { color: #7a8494; font-size: 24rpx; margin-bottom: 12rpx; }.person view { font-size: 35rpx; font-weight: 700; color: #163a63; }.person text { display: block; margin-top: 10rpx; color: #66798d; font-size: 26rpx; }.field { min-height: 88rpx; display: flex; align-items: center; border-bottom: 1rpx solid #edf0f4; }.field:last-child { border: 0; }.field > text { width: 145rpx; color: #4c5f73; font-size: 27rpx; }.field picker { flex: 1; }.picker-value { color: #1f2937; text-align: right; font-size: 27rpx; }.note { align-items: flex-start; padding: 20rpx 0; }.note textarea { flex: 1; height: 145rpx; font-size: 27rpx; }.save { margin-top: 30rpx; }
