.flow { display:flex; align-items:center; justify-content:center; gap:14rpx; margin:19rpx 0 32rpx; }.flow-step { width:39rpx; height:39rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; color:#8b98a4; background:#e7edf1; font-size:21rpx; }.flow-step.active { color:#fff; background:#2563eb; }.flow > view:not(.flow-step) { width:82rpx; height:2rpx; background:#dce5e9; }.intro { margin:0 5rpx 29rpx; }.intro view { color:#1f3a57; font-size:37rpx; font-weight:700; }.intro text { display:block; margin-top:9rpx; color:#85929e; font-size:24rpx; }.source-card { padding:29rpx; border-radius:14rpx; color:#fff; background:#12365f; }.source-card text:first-child { color:#9ed4ee; font-size:22rpx; }.source-card view { margin-top:11rpx; font-size:37rpx; font-weight:700; }.source-card text:last-child { display:block; margin-top:8rpx; opacity:.82; font-size:24rpx; }.section-title { margin:37rpx 4rpx 16rpx; color:#1f3a57; font-size:32rpx; font-weight:700; }.form-card { padding:0 25rpx; border-radius:14rpx; background:#fff; box-shadow:0 7rpx 22rpx rgba(19,58,99,.05); }.field { min-height:99rpx; display:flex; align-items:center; border-bottom:1rpx solid #edf1f3; }.field:last-child { border:0; }.field > text { width:160rpx; color:#53687a; font-size:27rpx; }.field picker { flex:1; }.field picker view { display:flex; justify-content:flex-end; color:#1f3a57; font-size:27rpx; }.field picker text { margin-left:15rpx; color:#2563eb; font-size:36rpx; }.field.note { align-items:flex-start; padding:24rpx 0; }.field textarea { flex:1; height:145rpx; font-size:26rpx; }.save-button { height:96rpx; display:flex; align-items:center; justify-content:center; gap:14rpx; margin-top:32rpx; border-radius:12rpx; color:#fff; background:#2563eb; font-size:30rpx; font-weight:600; }.save-button text:first-child { font-size:38rpx; }

.save-button[disabled] { opacity: .6; }
.save-button::after { border: 0; }
.source-card,.form-card { box-sizing:border-box; min-width:0; max-width:100%; word-wrap:break-word; }
.field { min-width:0; max-width:100%; box-sizing:border-box; }
.field > text { flex:0 0 160rpx; max-width:40%; }
.field textarea { flex:1 1 0%; width:0; min-width:0; box-sizing:border-box; }
.field picker { flex:1 1 0%; min-width:0; }
.field picker view { min-width:0; white-space:normal; word-wrap:break-word; }
.field picker text { flex:none; }
.target-selected { flex:1 1 0%; min-width:0; display:flex; align-items:center; justify-content:flex-end; gap:16rpx; }
.target-info { min-width:0; text-align:right; }
.target-name { display:block; color:#1f3a57; font-size:27rpx; font-weight:600; word-wrap:break-word; }
.target-meta { display:block; margin-top:4rpx; color:#85929e; font-size:22rpx; word-wrap:break-word; }
.target-change { flex:none; color:#2563eb; font-size:25rpx; }
.target-search { flex:1 1 0%; min-width:0; height:72rpx; padding:0 18rpx; border-radius:10rpx; background:#f3f6f8; font-size:26rpx; }
.target-list { max-height:520rpx; overflow-y:auto; border-bottom:1rpx solid #edf1f3; }
.target-row { padding:18rpx 4rpx; border-bottom:1rpx solid #f2f5f7; }
.target-row:last-child { border-bottom:0; }
.target-row .target-meta { margin-top:2rpx; }
.target-empty { padding:22rpx 4rpx; color:#85929e; font-size:24rpx; text-align:center; }
