<view class="page">
  <view class="card"><view class="caption">当前联系人</view><view class="person" wx:if="{{source}}"><view>{{source.name}}</view><text>{{source.position || '未填写职务'}} · {{source.organization || '未填写单位'}}</text></view></view>
  <view class="section-title">关系信息</view>
  <view class="card form">
    <view class="field"><text>关联人物</text><picker mode="selector" range="{{contacts}}" range-key="name" value="{{targetIndex}}" bindchange="targetChange"><view class="picker-value">{{targetName}} ›</view></picker></view>
    <view class="field"><text>关系类型</text><picker mode="selector" range="{{types}}" value="{{typeIndex}}" bindchange="typeChange"><view class="picker-value">{{typeName}} ›</view></picker></view>
    <view class="field note"><text>备注</text><textarea placeholder="例如：共同参与某项目" value="{{note}}" bindinput="noteInput" maxlength="200"/></view>
  </view>
  <button class="primary-button save" bindtap="save">保存关系</button>
</view>
