.logout-page { display:flex; align-items:center; min-height:calc(100vh - 56rpx); }.logout-card { width:100%; padding:42rpx 30rpx; border-radius:14rpx; background:#fff; box-sizing:border-box; box-shadow:0 8rpx 28rpx rgba(19,58,99,.06); }.logout-title { color:#173b64; font-size:36rpx; font-weight:700; }.logout-card > text { display:block; margin-top:18rpx; color:#728495; font-size:25rpx; line-height:1.7; }.logout-actions { display:flex; gap:18rpx; margin-top:38rpx; }.logout-actions button { flex:1; margin:0; border-radius:9rpx; font-size:28rpx; }.cancel { color:#46647d; background:#edf2f6; }.confirm { color:#fff; background:#cc5e58; }
