<view class="page legal-page">
  <view class="legal-title">{{doc.title}}</view>
  <view class="legal-updated">更新日期：{{doc.updated}}</view>
  <view class="card legal-card">
    <view class="legal-section" wx:for="{{doc.sections}}" wx:key="heading">
      <view class="legal-heading">{{item.heading}}</view>
      <text class="legal-paragraph" wx:for="{{item.paragraphs}}" wx:for-item="paragraph" wx:key="*this" user-select>{{paragraph}}</text>
    </view>
  </view>
  <button wx:if="{{canOpenWechatGuide}}" class="legal-guide" bindtap="openWechatGuide">查看小程序隐私保护指引</button>
</view>
