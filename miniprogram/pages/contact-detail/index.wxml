<view class="page" wx:if="{{contact}}">
  <settings-entry />
  <view class="profile-hero"><view class="avatar">{{contact.initial}}</view><view class="profile-main"><view class="profile-name">{{contact.name}}</view><view class="profile-role">{{contact.position || '未填写职务'}} · {{contact.organization || '未填写单位'}}</view><view class="tag-row"><text wx:for="{{contact.tags}}" wx:key="*this">{{item}}</text></view></view><view class="status">已联系人</view></view>
  <view class="quick-actions"><view bindtap="call"><text>☎</text><text>打电话</text></view><view bindtap="graph"><text>⌘</text><text>关系图谱</text></view><view bindtap="edit"><text>✎</text><text>编辑资料</text></view></view>
  <view class="section-head"><text>联系人信息</text><text>完整资料</text></view>
  <view class="info-card"><view><text>单位</text><text>{{contact.organization || '未填写'}}</text></view><view><text>职务</text><text>{{contact.position || '未填写'}}</text></view><view><text>研究 / 备注</text><text>{{contact.note || '未填写'}}</text></view><view><text>省份</text><text>{{contact.province || '未填写'}}</text></view><view><text>城市</text><text>{{contact.city || '未填写'}}</text></view><view><text>电话</text><text>{{contact.phone || '未填写'}}</text></view><view><text>邮箱</text><text>{{contact.email || '未填写'}}</text></view></view>
  <view class="section-head"><text>人物关系</text><text class="action-link" bindtap="addRelationship">＋ 新增关系</text></view>
  <view class="relations" wx:if="{{relationships.length}}"><view class="relation" wx:for="{{relationships}}" wx:key="id"><view class="relation-avatar" data-id="{{item.other.id}}" bindtap="openOther">{{item.other.name}}</view><view class="relation-main" data-id="{{item.other.id}}" bindtap="openOther"><view>{{item.other.name}} <text>{{item.label}}</text></view><view>{{item.summary || '未填写关系说明'}}</view></view><text class="remove" data-id="{{item.id}}" bindtap="removeRelationship">删除</text></view></view>
  <view class="empty" wx:else>尚未建立人物关系</view>
  <view class="graph-button" bindtap="graph"><text>⌘</text><text>查看关系图谱</text></view><view class="delete" bindtap="remove">删除联系人</view>
</view>
