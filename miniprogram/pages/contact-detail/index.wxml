<view class="page" wx:if="{{contact}}">
  <view class="card profile"><view class="avatar">{{contact.initial}}</view><view><view class="name">{{contact.name}}</view><view class="muted">{{contact.position || '未填写职务'}} · {{contact.organization || '未填写单位'}}</view><view class="tags"><text wx:for="{{contact.tags}}" wx:key="*this">{{item}}</text></view></view></view>
  <view class="quick"><view bindtap="call"><text>☎</text><text>打电话</text></view><view bindtap="graph"><text>◎</text><text>关系图谱</text></view><view bindtap="edit"><text>✎</text><text>编辑</text></view></view>
  <view class="section-title">基础信息</view>
  <view class="card info"><view><text>城市</text><text>{{contact.city || '未填写'}}</text></view><view><text>电话</text><text>{{contact.phone || '未填写'}}</text></view><view><text>邮箱</text><text>{{contact.email || '未填写'}}</text></view><view><text>备注</text><text>{{contact.note || '未填写'}}</text></view></view>
  <view class="section-title relation-title"><text>人物关系</text><text bindtap="addRelationship">＋ 新增关系</text></view>
  <view class="card"><view class="relation" wx:for="{{relationships}}" wx:key="id"><view class="relation-avatar" data-id="{{item.other.id}}" bindtap="openOther">{{item.other.name}}</view><view class="relation-main" data-id="{{item.other.id}}" bindtap="openOther"><view>{{item.other.name}} <text class="relation-label">{{item.label}}</text></view><view class="muted">{{item.summary || '未填写单位与备注'}}</view></view><text class="relation-delete" data-id="{{item.id}}" bindtap="removeRelationship">删除</text></view><view class="empty small" wx:if="{{!relationships.length}}">暂未建立关系</view></view>
  <view class="delete-action" bindtap="remove">删除联系人</view>
</view>
