.detail-page { padding-bottom:60rpx; }
.detail-identity { display:flex; align-items:center; gap:24rpx; margin:20rpx 0; }
.detail-avatar { flex:none; width:120rpx; height:120rpx; display:flex; align-items:center; justify-content:center; background:var(--accent-soft); color:var(--accent); border:1rpx solid #dce6fb; border-radius:34rpx; font-size:45rpx; font-weight:650; }
.detail-identity-main { flex:1; min-width:0; }
.detail-identity-main .ui-eyebrow { font-size:21rpx; margin-bottom:8rpx; }
.detail-name { font-size:42rpx; color:var(--ink); font-weight:700; line-height:1.4; overflow-wrap:anywhere; }
.detail-role { margin-top:8rpx; color:var(--muted); font-size:25rpx; overflow-wrap:anywhere; }
.detail-tags { display:flex; flex-wrap:wrap; gap:12rpx; margin:20rpx 0 28rpx; }
.detail-tags text { max-width:100%; padding:7rpx 15rpx; border-radius:10rpx; color:var(--accent); background:var(--accent-soft); font-size:23rpx; overflow-wrap:anywhere; }
.detail-actions { display:flex; gap:18rpx; margin:28rpx 0 30rpx; }
.detail-actions button { flex:1; min-width:0; }
.detail-panel { box-shadow:none; margin-bottom:20rpx; padding:26rpx; border-radius:20rpx; }
.detail-panel .ui-panel-title { font-size:28rpx; margin-bottom:10rpx; }
.detail-field { display:flex; align-items:baseline; gap:18rpx; padding:20rpx 0; border-bottom:1rpx solid var(--line-soft); font-size:26rpx; }
.detail-field:last-child { border:0; padding-bottom:6rpx; }
.detail-field-label { flex:0 0 140rpx; color:var(--muted); font-size:24rpx; }
.detail-field-value { flex:1; min-width:0; color:var(--text); overflow-wrap:anywhere; line-height:1.6; }
.detail-field .ui-link { font-size:23rpx; padding:0; }
.detail-note { color:#526174; font-size:26rpx; line-height:1.8; white-space:pre-wrap; overflow-wrap:anywhere; padding-top:12rpx; }
.empty-fields-toggle { margin:0 auto 20rpx; color:var(--muted); font-size:23rpx; }
.detail-section-heading { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin:22rpx 0 16rpx; }
.detail-section-heading .ui-panel-title > text { color:var(--muted); font-size:23rpx; margin-left:8rpx; font-weight:400; }
.relationship-panel { box-shadow:none; border-radius:20rpx; padding:0 22rpx; }
.relationship-row { display:flex; align-items:center; gap:16rpx; padding:24rpx 0; border-bottom:1rpx solid var(--line-soft); }
.relationship-row:last-child { border:0; }
.relation-avatar { flex:none; display:flex; align-items:center; justify-content:center; width:68rpx; height:68rpx; border-radius:18rpx; background:#f1f4f8; color:#718397; font-size:25rpx; }
.relationship-content { flex:1; min-width:0; }
.relationship-name { color:var(--ink); font-size:27rpx; font-weight:600; overflow-wrap:anywhere; }
.relationship-name > text { display:inline-block; padding:3rpx 10rpx; margin-left:12rpx; font-size:20rpx; font-weight:400; border-radius:8rpx; color:var(--accent); background:var(--accent-soft); }
.relationship-note { margin-top:8rpx; color:var(--muted); font-size:23rpx; overflow-wrap:anywhere; }
.relationship-remove { flex:none; padding:14rpx 0 14rpx 10rpx; margin:0; background:none; color:var(--muted); font-size:22rpx; line-height:1.5; }
.relationship-remove::after,.detail-delete::after { border:none; }
.detail-no-relations { padding:30rpx 24rpx; border:1rpx dashed #d8e0eb; border-radius:20rpx; background:#fff; color:var(--ink); font-size:26rpx; text-align:center; }
.detail-no-relations > text { display:block; margin-top:10rpx; color:var(--muted); font-size:23rpx; }
.detail-delete { margin:36rpx auto 0; padding:18rpx 0; background:none; color:#a66d68; font-size:24rpx; line-height:1.5; }
.detail-page .detail-panel,.detail-page .relationship-panel,.detail-no-relations { min-width:0; max-width:100%; box-sizing:border-box; }
.detail-name,.detail-role,.detail-field-value,.detail-note,.relationship-name,.relationship-note { word-wrap:break-word; overflow-wrap:break-word; word-break:break-word; }
.detail-tags text,.relationship-name > text { box-sizing:border-box; max-width:100%; word-wrap:break-word; }
.detail-page .detail-actions button { width:0; flex:1 1 0%; min-width:0; }
.detail-field { min-width:0; }
.detail-field .ui-link { flex:none; width:auto; }
.detail-section-heading { flex-wrap:wrap; }
.relationship-remove { width:auto; flex:none; }
@media (max-width:360px) {
  .detail-field { flex-wrap:wrap; }
  .detail-field-value { flex:1 1 200rpx; }
  .detail-field .ui-link { margin-left:auto; }
}
.relationship-edit { color:var(--accent); }
