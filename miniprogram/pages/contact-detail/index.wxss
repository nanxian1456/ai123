.profile { display: flex; align-items: center; }.avatar { width: 112rpx; height: 112rpx; display: flex; justify-content: center; align-items: center; border-radius: 50%; background: #d9ecff; color: #1677d2; font-size: 43rpx; font-weight: 700; margin-right: 24rpx; }.name { font-size: 40rpx; font-weight: 700; margin-bottom: 10rpx; }.tags text { display: inline-block; font-size: 21rpx; margin: 12rpx 8rpx 0 0; color: #387ab5; background: #edf6ff; padding: 4rpx 10rpx; border-radius: 8rpx; }.quick { display: flex; background: #fff; margin-top: 20rpx; border-radius: 16rpx; padding: 22rpx 0; }.quick view { flex: 1; display: flex; flex-direction: column; align-items: center; color: #1677d2; font-size: 25rpx; }.quick text:first-child { font-size: 39rpx; margin-bottom: 6rpx; }.info > view { display: flex; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid #edf0f4; font-size: 27rpx; }.info > view:last-child { border: 0; }.info text:first-child { color: #7a8494; }.info text:last-child { max-width: 70%; text-align: right; }.relation-title { display: flex; align-items: center; justify-content: space-between; }.relation-title text:last-child { color: #1677d2; font-size: 26rpx; font-weight: 500; }.relation { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #edf0f4; }.relation-avatar { width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #e8f3ff; color: #1677d2; font-size: 22rpx; overflow: hidden; }.relation-main { flex: 1; margin-left: 16rpx; font-size: 28rpx; }.relation-label { color: #1677d2; background: #e8f3ff; font-size: 21rpx; padding: 3rpx 8rpx; border-radius: 7rpx; margin-left: 6rpx; }.relation-delete { color: #e05b4f; font-size: 24rpx; padding: 14rpx; }.small { padding: 34rpx 0; }.delete-action { color: #e05b4f; font-size: 28rpx; text-align: center; padding: 42rpx 0 22rpx; }
