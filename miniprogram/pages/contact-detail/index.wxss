.profile-hero { display:flex; align-items:center; position:relative; padding:38rpx 30rpx; color:#fff; background:#12365f; border-radius:16rpx; }.avatar { width:112rpx; height:112rpx; flex:0 0 auto; display:flex; align-items:center; justify-content:center; background:#e4f9f7; color:#167e83; border-radius:50%; font-size:43rpx; font-weight:700; }.profile-main { min-width:0; flex:1; margin-left:22rpx; }.profile-name { font-size:40rpx; font-weight:700; }.profile-role { margin-top:10rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:25rpx; opacity:.84; }.tag-row text { display:inline-block; margin:12rpx 8rpx 0 0; padding:4rpx 10rpx; color:#d6f8f6; background:rgba(112,223,214,.18); border-radius:7rpx; font-size:20rpx; }.status { position:absolute; right:24rpx; top:23rpx; padding:5rpx 9rpx; border-radius:8rpx; color:#0b6d69; background:#d9f7ef; font-size:19rpx; }.quick-actions { display:flex; margin-top:18rpx; padding:23rpx 0; border-radius:14rpx; background:#fff; }.quick-actions view { flex:1; display:flex; flex-direction:column; align-items:center; color:#187cbe; font-size:23rpx; }.quick-actions text:first-child { margin-bottom:6rpx; font-size:37rpx; }.section-head { display:flex; align-items:center; justify-content:space-between; margin:38rpx 3rpx 16rpx; color:#18314e; font-size:32rpx; font-weight:700; }.section-head > text:last-child { color:#8190a1; font-size:22rpx; font-weight:400; }.section-head .action-link { color:#1684c3; font-size:25rpx; }.info-card,.relations { border-radius:14rpx; background:#fff; padding:0 25rpx; box-shadow:0 7rpx 22rpx rgba(19,58,99,.05); }.info-card > view { display:flex; justify-content:space-between; align-items:flex-start; gap:25rpx; padding:22rpx 0; border-bottom:1rpx solid #edf1f3; font-size:26rpx; }.info-card > view:last-child { border:0; }.info-card text:first-child { flex:0 0 160rpx; color:#85929f; }.info-card text:last-child { color:#273b4d; text-align:right; word-break:break-all; }.relation { display:flex; align-items:center; padding:20rpx 0; border-bottom:1rpx solid #edf1f3; }.relation:last-child { border:0; }.relation-avatar { width:64rpx; height:64rpx; flex:0 0 auto; display:flex; align-items:center; justify-content:center; overflow:hidden; border-radius:50%; color:#0d7f81; background:#dff6f3; font-size:22rpx; }.relation-main { min-width:0; flex:1; margin-left:16rpx; color:#25394a; font-size:27rpx; }.relation-main view:first-child { font-weight:600; }.relation-main text { margin-left:8rpx; padding:3rpx 8rpx; border-radius:6rpx; color:#187cbe; background:#e9f6ff; font-size:19rpx; font-weight:400; }.relation-main view:last-child { margin-top:6rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#8b96a0; font-size:21rpx; }.remove { padding:12rpx 4rpx 12rpx 16rpx; color:#d8645a; font-size:22rpx; }.empty { padding:42rpx 20rpx; border-radius:14rpx; color:#8a97a4; background:#fff; text-align:center; font-size:25rpx; }.graph-button { display:flex; align-items:center; justify-content:center; gap:13rpx; height:92rpx; margin-top:28rpx; border-radius:13rpx; color:#fff; background:#1684c3; font-size:29rpx; font-weight:600; }.graph-button text:first-child { font-size:38rpx; }.delete { padding:38rpx 0 14rpx; color:#d8645a; text-align:center; font-size:26rpx; }
