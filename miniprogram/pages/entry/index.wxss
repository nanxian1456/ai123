.entry-page { position: relative; width: 100vw; height: 100vh; overflow: hidden; background: #000; color: #fff; }.background { position: absolute; inset: 0; overflow: hidden; background: #000; }.earth-video { position: absolute; inset: 0; width: 100%; height: 100%; }
.entry-content { position: relative; z-index: 2; margin-top: 288rpx; padding: 0 45rpx; text-align: center; }.eyebrow { color: #82eae1; font-size: 19rpx; letter-spacing: 3rpx; }.headline { margin-top: 20rpx; color: #fff; font-size: 86rpx; line-height: 1.15; font-weight: 700; letter-spacing: 3rpx; }.subtitle { margin-top: 24rpx; color: rgba(255,255,255,.78); font-size: 28rpx; }.entry-action { position: absolute; z-index: 9; left: 38rpx; right: 38rpx; bottom: 64rpx; height:108rpx; }.entry-action.checking { display:flex; align-items:center; justify-content:center; border-radius:54rpx; color:rgba(255,255,255,.82); background:rgba(20,52,78,.8); font-size:25rpx; }.button { height: 104rpx; display: flex; align-items: center; justify-content: center; gap: 15rpx; overflow: hidden; border-radius: 54rpx; font-family: SimSun, "宋体", serif; font-size: 34rpx; }.primary { color: #0c1724; background: #fff; font-weight: 700; border: 2rpx solid #fff; box-shadow: 0 14rpx 42rpx rgba(255,255,255,.2); }.button-label,.arrow { display:inline-block; vertical-align:middle; line-height:104rpx; }.arrow { margin-left:15rpx; font-size: 52rpx; font-weight: 300; }.particle,.button-particles { display:none; }
