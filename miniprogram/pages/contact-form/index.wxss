.ai-card textarea { width: 100%; height: 130rpx; font-size: 27rpx; line-height: 1.5; margin-top: 14rpx; }.form-title { font-size: 30rpx; font-weight: 650; color: #163a63; }.import-row { display:flex; align-items:center; gap:16rpx; margin-top:16rpx; }.import-row input { flex:1; min-width:0; height:72rpx; padding:0 18rpx; border:1rpx solid #d6e1ec; border-radius:8rpx; box-sizing:border-box; font-size:25rpx; }.import-button { flex:0 0 128rpx; margin:0; background:#e9f4ff; color:#1677d2; border-radius:8rpx; font-size:26rpx; }.import-card text { display:block; margin-top:12rpx; color:#82909d; font-size:22rpx; }.extract { background: #e9f4ff; color: #1677d2; border-radius: 10rpx; margin: 12rpx 0 0; font-size: 27rpx; }.field { min-height: 82rpx; display: flex; align-items: center; border-bottom: 1rpx solid #edf0f4; }.field:last-child { border: 0; }.field > text { width: 132rpx; color: #4c5f73; font-size: 27rpx; }.field input { flex: 1; text-align: right; font-size: 27rpx; }.field.area { align-items: flex-start; padding: 20rpx 0; }.field textarea { flex: 1; height: 130rpx; font-size: 27rpx; }.save { margin-top: 30rpx; }
.ai-card { margin-bottom: 22rpx; }
.paste-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.paste-heading text { flex: 0 0 auto; color: #82909d; font-size: 23rpx; }
.ai-card .paste-input { width: 100%; height: 260rpx; padding: 18rpx; margin-top: 18rpx; box-sizing: border-box; border: 1rpx solid #d6e1ec; border-radius: 8rpx; background: #f8fbff; font-size: 27rpx; line-height: 1.5; }
.paste-actions { display: flex; gap: 14rpx; margin-top: 16rpx; }
.paste-actions button { flex: 1; height: 72rpx; margin: 0; border-radius: 8rpx; font-size: 26rpx; line-height: 72rpx; }
.paste-button { background: #e9f4ff; color: #1677d2; }
.clear-button { background: #f0f2f5; color: #53687a; }
.ai-card .extract { width: 100%; height: 82rpx; margin: 18rpx 0 0; border-radius: 8rpx; background: #1677d2; color: #fff; font-size: 28rpx; line-height: 82rpx; }
.ai-preview { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #e5edf5; }
.preview-title { margin-bottom: 12rpx; color: #163a63; font-size: 28rpx; font-weight: 600; }
.preview-field { display: flex; gap: 18rpx; padding: 11rpx 0; border-bottom: 1rpx solid #f0f3f6; font-size: 25rpx; line-height: 1.5; }
.preview-label { flex: 0 0 84rpx; color: #718294; }
.preview-value { flex: 1; min-width: 0; color: #243b53; word-break: break-all; }
.apply-draft { height: 82rpx; margin: 20rpx 0 0; border-radius: 8rpx; background: #168e85; color: #fff; font-size: 28rpx; line-height: 82rpx; }
.batch-button { width: 100%; height: 76rpx; margin: 12rpx 0 0; border-radius: 8rpx; background: #e8f2fa; color: #176b9d; font-size: 27rpx; line-height: 76rpx; }
.suggested-tags { display:flex; flex-wrap:wrap; align-items:center; gap:12rpx; padding:18rpx 0; }
.suggested-tags > text { width:100%; color:#4c5f73; font-size:25rpx; }
.suggested-tag { padding:9rpx 16rpx; border:1rpx solid #cbddec; border-radius:8rpx; background:#f5f9fc; color:#356c9d; font-size:24rpx; }
.suggested-tag.selected { border-color:#1677d2; background:#e6f2ff; color:#1464a8; font-weight:600; }
.custom-tag-field { padding:18rpx 0 4rpx; }
.custom-tag-field > text { display:block; margin-bottom:12rpx; color:#4c5f73; font-size:27rpx; }
.custom-tag-entry { display:flex; align-items:center; gap:12rpx; }
.custom-tag-entry input { flex:1; min-width:0; height:72rpx; padding:0 16rpx; border:1rpx solid #d6e1ec; border-radius:8rpx; box-sizing:border-box; text-align:left; font-size:26rpx; }
.custom-tag-entry button { flex:0 0 112rpx; width:112rpx; height:72rpx; margin:0; padding:0; border-radius:8rpx; background:#e9f4ff; color:#1677d2; font-size:25rpx; line-height:72rpx; }
.selected-tags { display:flex; flex-wrap:wrap; gap:10rpx; padding:14rpx 0 4rpx; }
.selected-tag { display:flex; align-items:center; gap:10rpx; width:auto; max-width:100%; height:56rpx; margin:0; padding:0 14rpx; border:1rpx solid #cbddec; border-radius:8rpx; background:#eaf4ff; color:#245f92; font-size:23rpx; line-height:56rpx; }
.selected-tag text { font-size:30rpx; }
