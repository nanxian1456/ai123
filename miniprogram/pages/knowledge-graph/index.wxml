<view class="page graph-page"><view class="page-head"><view><view class="eyebrow">关系网络</view><view class="title">知识图谱</view></view><view class="count">{{contacts.length}} 位联系人</view></view><view class="selector" wx:if="{{contacts.length}}"><text>中心联系人</text><picker range="{{contacts}}" range-key="name" value="{{selectedIndex}}" bindchange="selectContact"><view class="picker-value">{{contacts[selectedIndex].name}} <text>⌄</text></view></picker></view><view class="graph-card" wx:if="{{center}}"><view class="network"><view class="orbit orbit-one"></view><view class="orbit orbit-two"></view><view class="center-node"><view>{{center.initial}}</view><text>{{center.name}}</text><text class="center-role">{{center.organization || '中心联系人'}}</text></view><view class="graph-node {{item.position}}" wx:for="{{related}}" wx:key="id" data-id="{{item.id}}" bindtap="openContact"><view>{{item.initial}}</view><text>{{item.name}}</text><text class="relationship">{{item.relationship}}</text></view></view><view class="graph-footer"><text>{{edges.length}} 条直接关系</text><view bindtap="addRelationship">＋ 新增关系</view></view></view><view class="empty-card" wx:elif="{{!loading}}"><view>暂未添加联系人</view><text>先建立联系人，才能生成专属知识图谱</text><view class="add-button" bindtap="addContact">新增联系人</view></view><view class="loading" wx:else>正在加载知识图谱</view><view class="section-head" wx:if="{{center}}"><view>关系说明</view><text>点击节点查看详情</text></view><view class="edges" wx:if="{{edges.length}}"><view wx:for="{{edges}}" wx:key="id"><view class="edge-icon">⌘</view><text>{{item.type}}</text><text>已建立</text></view></view><view class="empty-relations" wx:if="{{center && !edges.length}}">暂无关系，可点击“新增关系”开始连接</view></view>
