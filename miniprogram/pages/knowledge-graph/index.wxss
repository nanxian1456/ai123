.graph-page { min-height:100vh; background:#f3f7fa; }.page-head { display:flex; align-items:flex-end; justify-content:space-between; padding:12rpx 4rpx 26rpx; }.eyebrow { color:#1684c3; font-size:21rpx; font-weight:600; }.title { margin-top:6rpx; color:#17324e; font-size:42rpx; font-weight:700; }.count { padding:8rpx 11rpx; border-radius:8rpx; color:#467086; background:#e4f0f7; font-size:20rpx; }.selector { display:flex; align-items:center; justify-content:space-between; margin-bottom:20rpx; padding:19rpx 22rpx; border-radius:13rpx; color:#526a7e; background:#fff; box-shadow:0 7rpx 22rpx rgba(19,58,99,.05); font-size:25rpx; }.picker-value { min-width:220rpx; color:#176ea6; text-align:right; font-weight:600; }.picker-value text { margin-left:10rpx; color:#8aa4b7; }.graph-card { overflow:hidden; border-radius:17rpx; background:#0d2d4a; box-shadow:0 12rpx 30rpx rgba(18,54,83,.18); }.network { height:590rpx; position:relative; overflow:hidden; background:radial-gradient(circle at 50% 52%,#205d7b 0,#103650 43%,#0a1d34 100%); }.orbit { position:absolute; left:50%; top:53%; border:1rpx solid rgba(102,224,211,.3); border-radius:50%; transform:translate(-50%,-50%); }.orbit-one { width:510rpx; height:340rpx; transform:translate(-50%,-50%) rotate(-22deg); }.orbit-two { width:310rpx; height:500rpx; transform:translate(-50%,-50%) rotate(22deg); border-color:rgba(130,182,255,.25); }.center-node,.graph-node { position:absolute; z-index:2; display:flex; flex-direction:column; align-items:center; text-align:center; }.center-node { left:50%; top:50%; width:180rpx; transform:translate(-50%,-50%); color:#fff; font-size:25rpx; font-weight:700; }.center-node view { width:105rpx; height:105rpx; display:flex; align-items:center; justify-content:center; border:7rpx solid rgba(220,255,250,.7); border-radius:50%; color:#082737; background:#65ddd3; box-shadow:0 0 35rpx rgba(91,229,214,.75); font-size:39rpx; }.center-node text { margin-top:9rpx; }.center-node .center-role { max-width:170rpx; overflow:hidden; color:#afd0df; text-overflow:ellipsis; white-space:nowrap; font-size:19rpx; font-weight:400; }.graph-node { color:#e8fbff; font-size:22rpx; }.graph-node view { width:69rpx; height:69rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; color:#0d3450; background:#b8e9f7; box-shadow:0 0 24rpx rgba(144,213,244,.6); font-size:27rpx; font-weight:700; }.graph-node .relationship { margin-top:4rpx; padding:3rpx 8rpx; border-radius:7rpx; color:#c7fbf5; background:rgba(101,221,210,.18); font-size:18rpx; }.graph-node.top { left:50%; top:55rpx; transform:translateX(-50%); }.graph-node.right { right:44rpx; top:252rpx; }.graph-node.bottom { left:50%; bottom:32rpx; transform:translateX(-50%); }.graph-node.left { left:44rpx; top:252rpx; }.graph-footer { display:flex; align-items:center; justify-content:space-between; padding:22rpx 25rpx; color:#b8d2df; font-size:23rpx; }.graph-footer view { padding:10rpx 14rpx; border-radius:8rpx; color:#e4fffc; background:#187e92; font-size:22rpx; }.section-head { display:flex; justify-content:space-between; align-items:center; margin:38rpx 4rpx 16rpx; }.section-head view { color:#17324e; font-size:32rpx; font-weight:700; }.section-head text { color:#8997a3; font-size:22rpx; }.edges { padding:0 25rpx; border-radius:14rpx; background:#fff; box-shadow:0 7rpx 22rpx rgba(19,58,99,.05); }.edges > view { display:flex; align-items:center; gap:13rpx; padding:22rpx 0; border-bottom:1rpx solid #edf1f3; color:#263d50; font-size:27rpx; }.edges > view:last-child { border:0; }.edge-icon { display:flex; align-items:center; justify-content:center; width:45rpx; height:45rpx; border-radius:50%; color:#1684c3; background:#e7f5ff; font-size:26rpx; }.edges text:last-child { margin-left:auto; color:#8d99a4; font-size:21rpx; }.empty-card,.empty-relations,.loading { padding:65rpx 24rpx; border-radius:15rpx; background:#fff; color:#6e8291; text-align:center; font-size:27rpx; }.empty-card text { display:block; margin-top:12rpx; color:#98a6af; font-size:22rpx; }.add-button { height:82rpx; display:flex; align-items:center; justify-content:center; margin:30rpx 35rpx 0; border-radius:10rpx; color:#fff; background:#1684c3; font-size:27rpx; font-weight:600; }.empty-relations { padding:45rpx 20rpx; font-size:24rpx; }.loading { margin-top:20rpx; }
