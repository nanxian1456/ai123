<view class="page directory-page">
  <settings-entry />
  <view class="search"><input placeholder="搜索姓名、单位或职务" value="{{keyword}}" bindinput="onKeyword" confirm-type="search" bindconfirm="search"/><text bindtap="search">搜索</text></view>
  <view class="filter-row" wx:if="{{filterLabel}}"><text>{{filterLabel}}</text><text bindtap="clearCity">清除</text></view>
  <view class="contact-organize">
    <text class="app-help">标签用于筛选；分类用于图谱树的分支。</text>
    <button class="app-action" size="mini" bindtap="manageCategories">管理分类</button>
  </view>
  <view class="tag-filters">
    <view class="tag-filter {{selectedTag === '' ? 'active' : ''}}" bindtap="selectTag" data-tag="">全部标签</view>
    <view class="tag-filter {{selectedTag === item.name ? 'active' : ''}}" wx:for="{{tags}}" wx:key="name" bindtap="selectTag" data-tag="{{item.name}}">{{item.name}}<text wx:if="{{item.count}}" class="tag-count">{{item.count}}</text></view>
    <view class="tag-filter create-tag" bindtap="createTag">＋ 自定义标签</view>
  </view>
  <scroll-view class="directory" scroll-y="true" scroll-into-view="{{scrollIntoView}}" scroll-with-animation="true" wx:if="{{groups.length}}">
    <view class="directory-group" wx:for="{{groups}}" wx:key="letter" id="letter-{{item.letter}}">
      <view class="group-letter">{{item.letter}}</view>
      <view class="group-card"><view class="item" wx:for="{{item.contacts}}" wx:key="id" wx:for-item="contact" data-id="{{contact.id}}" bindtap="detail"><view class="avatar">{{contact.initial}}</view><view class="info"><view class="name">{{contact.name}}</view><view class="muted">{{contact.position || '未填写职务'}} · {{contact.organization || '未填写单位'}}</view><view class="tags"><text wx:for="{{contact.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text></view></view><view class="place">{{contact.city}}</view></view></view>
    </view>
  </scroll-view>
  <view class="app-state" wx:if="{{loading}}" role="status">正在加载联系人…</view>
  <view class="app-state app-state--error" wx:elif="{{loadError}}">{{loadError}}<button class="app-action" bindtap="loadContacts">重新加载</button></view>
  <view class="app-state" wx:elif="{{!groups.length}}">{{selectedTag || keyword || regionFilter || city ? '没有符合条件的联系人' : '暂无联系人，开始添加第一位联系人'}}</view>
  <view class="letter-index"><view wx:for="{{letters}}" wx:key="letter" data-letter="{{item.letter}}" bindtap="jumpLetter" class="letter {{item.available ? 'available' : ''}}">{{item.letter}}</view></view>
  <button class="add" bindtap="add">＋ 新增联系人</button>
</view>
