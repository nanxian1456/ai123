<view class="page ui-page directory-page">
  <view class="directory-heading"><view><view class="ui-eyebrow">记录与查找</view><view class="ui-title">联系人</view></view><button class="ui-link" bindtap="manageCategories">管理分类 ›</button></view>
  <view class="directory-search"><text class="search-symbol">⌕</text><input placeholder="搜索姓名、单位、标签、备注或电话" value="{{keyword}}" bindinput="onKeyword" bindconfirm="search" confirm-type="search" /><button bindtap="search">搜索</button></view>
  <scroll-view class="tag-strip" scroll-x="{{true}}"><view class="tag-strip-inner">
    <button class="tag-filter {{!selectedTag ? 'active' : ''}}" data-tag="" bindtap="selectTag">全部标签</button>
    <button class="tag-filter {{selectedTag === item.name ? 'active' : ''}}" wx:for="{{tags}}" wx:key="name" data-tag="{{item.name}}" bindtap="selectTag"><text class="tag-filter-label">{{item.name}}</text><text class="tag-filter-count" wx:if="{{item.count}}">{{item.count}}</text></button>
    <button class="tag-filter create-tag" bindtap="createTag" disabled="{{creatingTag}}">＋ 标签</button>
  </view></scroll-view>
  <view class="directory-summary"><text>{{searchPending ? '正在筛选…' : (loading ? '正在读取…' : '当前列表 ' + total + ' 位')}}</text><button wx:if="{{keyword || selectedTag || filterLabel || city}}" class="ui-link" bindtap="clearFilters">清除筛选</button></view>
  <view class="region-chip" wx:if="{{filterLabel}}"><text>{{filterLabel}}</text><button bindtap="clearCity" aria-label="清除地区筛选">×</button></view>
  <scroll-view class="directory" scroll-y="{{true}}" scroll-into-view="{{scrollIntoView}}" scroll-with-animation="{{true}}" lower-threshold="400" bindscrolltolower="onListBottom" wx:if="{{sections.length}}">
    <view class="directory-group {{item.last ? '' : 'directory-group--more'}}" wx:for="{{sections}}" wx:key="key" id="{{item.first ? 'letter-' + item.letter : ''}}">
      <view class="group-letter" wx:if="{{item.first}}">{{item.letter}}</view>
      <view class="group-card {{item.first ? '' : 'group-card--cont'}} {{item.last ? '' : 'group-card--more'}}">
        <button class="directory-person" wx:for="{{item.contacts}}" wx:for-item="contact" wx:key="id" data-id="{{contact.id}}" bindtap="detail">
          <view class="directory-avatar">{{contact.initial}}</view>
          <view class="directory-person-main"><view class="directory-person-name">{{contact.name}}</view>
            <view class="directory-person-meta">{{contact.organization || contact.position || '资料待补充'}}<text wx:if="{{contact.organization && contact.position}}"> · {{contact.position}}</text></view>
            <view class="person-tags" wx:if="{{contact.tags.length}}"><text wx:for="{{contact.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text><text wx:if="{{contact.moreTags}}">+{{contact.moreTags}}</text></view>
          </view>
          <text class="directory-city">{{contact.city}}</text><text class="directory-chevron">›</text>
        </button>
      </view>
    </view>
  </scroll-view>
  <view class="directory-feedback" wx:if="{{!sections.length}}">
    <view class="app-state" wx:if="{{loading || searchPending}}" role="status">{{searchPending ? '正在筛选联系人…' : '正在加载联系人…'}}</view>
    <view class="app-state app-state--error" wx:elif="{{loadError}}">{{loadError}}<button class="app-action" bindtap="loadContacts">重新加载</button></view>
    <view class="directory-empty" wx:else><view>{{selectedTag || keyword || regionFilter || city ? '没有找到匹配的联系人' : '你的联系人库还是空的'}}</view><text>{{selectedTag || keyword || regionFilter || city ? '试试其他关键词，或清除筛选条件。' : '先记录姓名，之后再慢慢补齐资料。'}}</text></view>
  </view>
  <view class="directory-inline-error" wx:if="{{loadError && sections.length}}">{{loadError}}<button class="ui-link" bindtap="loadContacts">重试</button></view>
  <view class="letter-index" wx:if="{{sections.length}}"><button wx:for="{{letters}}" wx:key="letter" data-letter="{{item.letter}}" bindtap="jumpLetter" class="letter {{item.available ? 'available' : ''}}">{{item.letter}}</button></view>
  <view class="directory-footer"><button class="ui-primary" bindtap="add">＋ 新增联系人</button></view>
</view>
