.directory-page { height:100vh; padding-bottom:0; overflow:hidden; }.search { background:#fff; height:78rpx; border-radius:14rpx; display:flex; align-items:center; padding:0 22rpx; margin-bottom:16rpx; box-shadow:0 6rpx 18rpx rgba(19,58,99,.05); }.search input { flex:1; font-size:27rpx; }.search text { color:#1677d2; font-size:27rpx; margin-left:16rpx; }.filter-row { display:flex; justify-content:space-between; background:#e8f3ff; color:#2875b6; border-radius:10rpx; padding:14rpx 18rpx; font-size:25rpx; margin-bottom:14rpx; }.tag-scroll { white-space:nowrap; margin-bottom:18rpx; }.tag-filter { display:inline-block; padding:11rpx 17rpx; margin-right:12rpx; border-radius:20rpx; color:#607890; background:#eaf0f5; font-size:24rpx; }.tag-filter.active { color:#fff; background:#1677d2; }.directory { height:calc(100vh - 286rpx); padding:0 46rpx 154rpx 0; box-sizing:border-box; }.directory-group { margin-bottom:20rpx; }.group-letter { padding:0 0 10rpx 4rpx; color:#55708d; font-size:28rpx; font-weight:700; }.group-card { background:#fff; border-radius:14rpx; padding:0 24rpx; box-shadow:0 6rpx 18rpx rgba(19,58,99,.05); }.item { display:flex; align-items:center; padding:22rpx 0; border-bottom:1rpx solid #eef1f4; }.item:last-child { border:0; }.avatar { width:76rpx; height:76rpx; flex:0 0 76rpx; display:flex; justify-content:center; align-items:center; border-radius:50%; background:#d9ecff; color:#1677d2; font-weight:700; }.info { flex:1; margin-left:18rpx; min-width:0; }.name { font-size:31rpx; font-weight:600; margin-bottom:8rpx; }.place { color:#5e7996; font-size:25rpx; }.tags text { display:inline-block; background:#edf6ff; color:#387ab5; padding:4rpx 10rpx; border-radius:8rpx; font-size:21rpx; margin:10rpx 8rpx 0 0; }.letter-index { position:fixed; z-index:3; top:208rpx; right:8rpx; width:34rpx; text-align:center; }.letter { height:31rpx; color:#c1cad4; font-size:19rpx; line-height:31rpx; }.letter.available { color:#1677d2; font-weight:700; }.empty { margin-top:90rpx; padding-right:40rpx; }.add { position:fixed; z-index:4; bottom:34rpx; left:28rpx; right:28rpx; background:#1677d2; color:#fff; border-radius:14rpx; font-size:30rpx; }
