.directory-page { height:100vh; display:flex; flex-direction:column; overflow:hidden; padding-bottom:0; }
.directory-heading { flex:none; display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin:8rpx 0 24rpx; }
.directory-heading .ui-title { font-size:44rpx; }
.directory-search { flex:none; display:flex; align-items:center; gap:14rpx; min-height:88rpx; padding:0 20rpx; background:#fff; border:1rpx solid var(--line); border-radius:18rpx; }
.search-symbol { color:var(--muted); font-size:39rpx; line-height:1; }
.directory-search input { flex:1; min-width:0; font-size:27rpx; height:84rpx; }
.directory-search button { flex:none; padding:16rpx 0 16rpx 10rpx; margin:0; background:none; color:var(--accent); font-size:26rpx; line-height:1.5; }
.directory-search button::after,.tag-filter::after,.directory-person::after,.region-chip button::after,.letter::after { border:none; }
.tag-strip { flex:none; width:100%; margin-top:20rpx; white-space:nowrap; }
.tag-strip-inner { display:inline-flex; align-items:center; gap:12rpx; padding:0 0 8rpx; }
.tag-filter { flex:none; display:inline-flex; align-items:center; gap:8rpx; margin:0; padding:13rpx 20rpx; border-radius:14rpx; border:1rpx solid var(--line); color:var(--muted); background:#fff; font-size:24rpx; line-height:1.5; }
.tag-filter text { font-size:20rpx; opacity:.7; }
.tag-filter.active { background:var(--accent); border-color:var(--accent); color:#fff; }
.create-tag { border-style:dashed; color:var(--accent); background:none; }
.directory-summary { flex:none; display:flex; align-items:center; justify-content:space-between; min-height:62rpx; font-size:23rpx; color:var(--muted); }
.directory-summary .ui-link { padding:10rpx 0; font-size:23rpx; }
.region-chip { flex:none; display:flex; align-items:center; gap:12rpx; padding:10rpx 18rpx; margin-bottom:14rpx; background:var(--accent-soft); color:var(--accent); border-radius:12rpx; font-size:23rpx; }
.region-chip > text { flex:1; min-width:0; overflow-wrap:anywhere; }
.region-chip button { flex:none; margin:0; padding:0 8rpx; color:var(--accent); background:none; font-size:31rpx; line-height:1.4; }
.directory { flex:1; min-height:0; height:0; box-sizing:border-box; padding:0 26rpx calc(156rpx + env(safe-area-inset-bottom)) 0; }
.directory-group { margin-bottom:22rpx; }
.group-letter { padding:6rpx 4rpx 12rpx; color:var(--muted); font-size:24rpx; font-weight:650; }
.group-card { background:#fff; border:1rpx solid var(--line); border-radius:20rpx; padding:0 22rpx; overflow:hidden; }
.directory-person { display:flex; align-items:center; gap:16rpx; margin:0; padding:24rpx 0; border-radius:0; background:#fff; border-bottom:1rpx solid var(--line-soft); color:var(--text); text-align:left; line-height:1.45; }
.directory-person:last-child { border:0; }
/* A long letter group is rendered as several consecutive sections that look like one card. */
.directory-group--more { margin-bottom:0; }
.group-card--cont { border-top:0; border-top-left-radius:0; border-top-right-radius:0; }
.group-card--more { border-bottom:0; border-bottom-left-radius:0; border-bottom-right-radius:0; }
.group-card--more .directory-person:last-child { border-bottom:1rpx solid var(--line-soft); }
.directory-avatar { flex:none; width:76rpx; height:76rpx; display:flex; align-items:center; justify-content:center; border-radius:22rpx; color:var(--accent); background:var(--accent-soft); font-size:29rpx; font-weight:650; }
.directory-person-main { flex:1; min-width:0; }
.directory-person-name { font-size:30rpx; font-weight:650; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.directory-person-meta { color:var(--muted); font-size:23rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; margin-top:6rpx; }
.person-tags { display:flex; flex-wrap:wrap; gap:8rpx; margin-top:10rpx; }
.person-tags text { max-width:170rpx; padding:3rpx 10rpx; background:#f3f5f8; border-radius:7rpx; color:#66788b; font-size:20rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.directory-city { flex:none; max-width:100rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--muted); font-size:22rpx; }
.directory-chevron { color:#a4aeb8; font-size:31rpx; }
.letter-index { position:fixed; z-index:3; top:50%; transform:translateY(-50%); right:2rpx; width:34rpx; }
.letter { width:34rpx; height:29rpx; min-height:0; margin:0; padding:0; border-radius:0; text-align:center; color:#c7cdd5; background:none; font-size:18rpx; line-height:29rpx; }
.letter.available { color:var(--accent); font-weight:700; }
.directory-footer { position:fixed; z-index:5; left:32rpx; right:32rpx; bottom:calc(24rpx + env(safe-area-inset-bottom)); }
.directory-footer .ui-primary { box-shadow:0 8rpx 24rpx rgba(37,99,235,.18); }
.directory-feedback { flex:1; min-height:0; padding:34rpx 0 140rpx; }
.directory-empty { padding:50rpx 24rpx; color:var(--ink); font-size:29rpx; text-align:center; }
.directory-empty text { display:block; margin-top:12rpx; color:var(--muted); font-size:24rpx; }
.directory-inline-error { flex:none; display:flex; align-items:center; justify-content:space-between; color:#a43f37; font-size:23rpx; padding-bottom:140rpx; }
.directory-heading > view { flex:1; min-width:0; }
.directory-heading .ui-link { flex:none; width:auto; }
.directory-page button.directory-person:not([size="mini"]) { width:100%; min-width:0; box-sizing:border-box; }
.directory-person,.tag-filter { font-weight:400; }
.directory,.group-card,.directory-search,.region-chip { min-width:0; max-width:100%; box-sizing:border-box; }
.directory-search input { width:0; flex:1 1 0%; }
.directory-page .directory-search button,.directory-page .tag-filter,.directory-page .region-chip button { width:auto; }
.tag-strip-inner { min-width:100%; }
.tag-filter { max-width:500rpx; white-space:normal; word-wrap:break-word; }
.tag-filter .tag-filter-label { flex:1; min-width:0; font-size:24rpx; opacity:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.tag-filter-count { flex:none; }
.person-tags text { box-sizing:border-box; min-width:0; max-width:100%; }
.directory-chevron { flex:none; }
.directory-inline-error { gap:16rpx; flex-wrap:wrap; word-wrap:break-word; }
