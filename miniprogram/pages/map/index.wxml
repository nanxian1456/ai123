<view class="page map-page">
  <settings-entry />

  <view class="map-summary">
    <view class="summary-title">人脉地区分布</view>
    <view class="summary-numbers">
      <view><text>{{total}}</text><text>联系人</text></view>
      <view><text>{{citySelected ? cityContacts.length : regions.length}}</text><text>{{levelTitle}}</text></view>
    </view>
  </view>

  <view class="globe-shell" hidden="{{level !== 'country'}}">
    <canvas id="globe-canvas" type="webgl" class="globe-canvas" bindtouchstart="globeTouchStart" bindtouchmove="globeTouchMove" bindtouchend="globeTouchEnd"></canvas>
    <view wx:if="{{globeError}}" class="globe-caption">{{globeError}}</view>
    <button class="globe-reset" bindtap="resetGlobe">回到地球</button>
  </view>

  <block wx:if="{{level !== 'country'}}">
    <map wx:if="{{center && includePoints.length && !coordinateLoading}}" class="region-map" latitude="{{center.latitude}}" longitude="{{center.longitude}}" scale="{{mapScale}}" markers="{{markers}}" polygons="{{provincePolygons}}" include-points="{{includePoints}}" data-load-id="{{mapLoadId}}" bindupdated="onMapUpdated" binderror="onMapError" bindmarkertap="mapMarkerTap" show-location="{{false}}" enable-zoom="{{true}}" enable-scroll="{{true}}" show-compass="{{true}}" />
    <view wx:else class="map-placeholder" role="status">{{coordinateLoading ? '正在获取地区坐标…' : (mapError || '当前地区暂无可显示的位置')}}</view>
    <view wx:if="{{mapWaiting}}" class="app-state" role="status">已取得坐标，正在等待地图更新…</view>
    <view wx:if="{{mapSlow}}" class="app-state app-state--warning" role="status">地图更新较慢，可稍候或切换网络。下方联系人列表仍可使用。</view>
    <view wx:if="{{center && !coordinateLoading}}" class="app-help">底图由微信加载。若仍空白，可切换网络后重新加载。</view>
    <view wx:if="{{(mapSlow || mapError || center) && !coordinateLoading}}" class="app-state">
      <button class="app-action" bindtap="retryMap" disabled="{{loading}}">重新加载地图</button>
    </view>
  </block>

  <view wx:if="{{mapError && center}}" class="app-state app-state--warning">{{mapError}}</view>

  <view class="path">
    <button class="path-item" bindtap="backToWorld">全球</button>
    <block wx:if="{{level !== 'country'}}">
      <text class="separator">›</text>
      <button class="path-item" bindtap="backToCountry" disabled="{{level === 'province'}}">{{country || '未设置国家'}}</button>
    </block>
    <block wx:if="{{level === 'city'}}">
      <text class="separator">›</text>
      <button wx:if="{{citySelected}}" class="path-item" bindtap="backToCityList">{{province || '未设置省份'}}</button>
      <text wx:else class="path-current">{{province || '未设置省份'}}</text>
      <block wx:if="{{citySelected}}">
        <text class="separator">›</text>
        <text class="path-current">{{city || '未设置城市'}}</text>
      </block>
    </block>
  </view>

  <view class="section-head">
    <view>{{levelTitle}}</view>
    <text>{{citySelected ? filteredContacts.length + ' 位联系人' : total + ' 人'}}</text>
  </view>
  <button wx:if="{{citySelected}}" class="directory-action" bindtap="viewCityContacts">在联系人页查看</button>

  <view class="search-bar">
    <input class="search-input" type="text" placeholder="搜索{{levelTitle}}…" value="{{keyword}}" bindinput="onKeyword" confirm-type="search" />
    <text wx:if="{{keyword}}" class="search-clear" bindtap="clearKeyword">×</text>
  </view>

  <picker wx:if="{{regions.length && !citySelected}}" class="region-picker" mode="selector" range="{{regions}}" range-key="pickerLabel" bindchange="selectFromPicker">
    <view>选择{{levelTitle}} <text>⌄</text></view>
  </picker>

  <view wx:if="{{!loading && !error && !citySelected && filteredRegions.length}}" class="region-list">
    <button class="region-row" wx:for="{{filteredRegions}}" wx:key="name" data-name="{{item.name}}" bindtap="selectRegion">
      <view class="region-main">
        <view class="region-left">
          <view class="avatar-stack" wx:if="{{item.sample.length}}">
            <view class="mini-avatar" wx:for="{{item.sample}}" wx:for-item="sample" wx:key="id" style="background-color: {{sample.color}};">{{sample.initial}}</view>
          </view>
          <text class="region-name">{{item.label}}</text>
        </view>
        <text class="region-count">{{item.count}} 人</text>
      </view>
      <progress class="region-bar" percent="{{item.percent}}" stroke-width="4" activeColor="#16a889" backgroundColor="#e8eef0" />
      <text class="region-arrow">›</text>
    </button>
  </view>

  <view wx:if="{{!loading && !error && citySelected && filteredContacts.length}}" class="contact-list">
    <view class="contact-row" wx:for="{{filteredContacts}}" wx:key="id" data-id="{{item.id}}" bindtap="focusContact">
      <view class="avatar" style="background-color: {{item.color}};">{{item.initial}}</view>
      <view class="contact-info">
        <view class="contact-name">{{item.name}}</view>
        <view class="contact-meta">{{item.organization}}<text wx:if="{{item.position}}"> · {{item.position}}</text></view>
        <view class="contact-tags" wx:if="{{item.tags.length}}">
          <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>
      </view>
      <text class="contact-location-action" catchtap="setContactLocation" data-id="{{item.id}}">设置位置</text>
      <text class="region-arrow">›</text>
    </view>
  </view>

  <view class="app-state" wx:if="{{loading}}" role="status">正在加载地区数据…</view>
  <view class="app-state app-state--error" wx:elif="{{error}}"><text>{{error}}</text><button class="app-action" bindtap="load">重新加载</button></view>
  <view class="app-state" wx:elif="{{citySelected ? !filteredContacts.length : !filteredRegions.length}}">暂无匹配数据</view>
</view>
