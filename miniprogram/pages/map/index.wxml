<view class="page ui-page map-page">
  <view class="map-summary">
    <view class="summary-title">人脉地区分布</view>
    <view class="summary-numbers">
      <view><text>{{total}}</text><text>联系人</text></view>
      <view><text>{{citySelected ? cityContactCount : regions.length}}</text><text>{{levelTitle}}</text></view>
    </view>
  </view>

  <view class="globe-shell" hidden="{{level !== 'country'}}">
    <canvas id="globe-canvas" type="webgl" class="globe-canvas" bindtouchstart="globeTouchStart" bindtouchmove="globeTouchMove" bindtouchend="globeTouchEnd"></canvas>
    <view wx:if="{{!globeReady && !globeError}}" class="globe-loading" role="status">正在加载地球…</view>
    <view wx:if="{{globeError}}" class="globe-caption">{{globeError}}</view>
    <view wx:elif="{{globeReady && regions.length}}" class="globe-caption">拖动旋转 · 双指缩放 · 点亮点进入国家</view>
    <button class="globe-reset" bindtap="resetGlobe">重置视角</button>
  </view>

  <block wx:if="{{level !== 'country'}}">
    <map wx:if="{{center && includePoints.length && !coordinateLoading}}" id="region-map" class="region-map" latitude="{{center.latitude}}" longitude="{{center.longitude}}" scale="{{mapScale}}" markers="{{markers}}" polygons="{{provincePolygons}}" include-points="{{includePoints}}" data-load-id="{{mapLoadId}}" bindupdated="onMapUpdated" binderror="onMapError" bindmarkertap="mapMarkerTap" show-location="{{false}}" enable-zoom="{{true}}" enable-scroll="{{true}}" show-compass="{{true}}" />
    <view wx:else class="map-placeholder" role="status">
      <text>{{coordinateLoading ? '正在获取地区坐标…' : (mapError || '当前地区暂无可显示的位置')}}</text>
      <button wx:if="{{!coordinateLoading && mapError}}" class="ui-link" bindtap="retryMap" disabled="{{loading}}">重新加载</button>
    </view>
    <!-- One status line under the map: the most important of slow loading, a partial result or waiting. -->
    <view wx:if="{{center && !coordinateLoading && (mapSlow || mapError || mapWaiting)}}" class="map-status {{mapSlow || mapError ? 'map-status--warn' : ''}}" role="status">
      <text>{{mapSlow ? '底图加载较慢，可稍候或切换网络后重新加载；下方列表仍可使用。' : (mapError || '正在加载底图…')}}</text>
      <button wx:if="{{mapSlow || mapError}}" class="ui-link" bindtap="retryMap" disabled="{{loading}}">重新加载</button>
    </view>
    <view wx:if="{{citySelected && approximateCount && !coordinateLoading}}" class="map-status" role="note">
      <text>{{approximateCount}} 位联系人没有保存具体位置，半透明标记为城市附近的估算位置。</text>
    </view>
  </block>

  <view class="path">
    <button class="path-item" bindtap="backToWorld">全球</button>
    <block wx:if="{{level !== 'country'}}">
      <text class="separator">›</text>
      <button class="path-item" bindtap="backToCountry" disabled="{{level === 'province'}}">{{country || '未设置国家'}}</button>
    </block>
    <block wx:if="{{level === 'city'}}">
      <text class="separator">›</text>
      <button wx:if="{{citySelected}}" class="path-item" bindtap="backToCityList">{{province || '未设置省份'}}</button>
      <text wx:else class="path-current">{{province || '未设置省份'}}</text>
      <block wx:if="{{citySelected}}">
        <text class="separator">›</text>
        <text class="path-current">{{city || '未设置城市'}}</text>
      </block>
    </block>
  </view>

  <view class="section-head">
    <view>{{levelTitle}}</view>
    <text>{{citySelected ? filteredContacts.length + ' 位联系人' : total + ' 人'}}</text>
  </view>
  <button wx:if="{{citySelected}}" class="directory-action" bindtap="viewCityContacts">在联系人页查看</button>

  <view class="search-bar">
    <input class="search-input" type="text" placeholder="搜索{{levelTitle}}…" value="{{keyword}}" bindinput="onKeyword" confirm-type="search" />
    <text wx:if="{{keyword}}" class="search-clear" bindtap="clearKeyword">×</text>
  </view>

  <picker wx:if="{{filteredRegions.length && !citySelected}}" class="region-picker" mode="selector" range="{{filteredRegions}}" range-key="pickerLabel" bindchange="selectFromPicker">
    <view>选择{{levelTitle}} <text>⌄</text></view>
  </picker>

  <view wx:if="{{!loading && !error && !citySelected && filteredRegions.length}}" class="region-list">
    <button class="region-row" wx:for="{{filteredRegions}}" wx:key="name" data-name="{{item.name}}" bindtap="selectRegion">
      <view class="region-main">
        <view class="region-left">
          <view class="avatar-stack" wx:if="{{item.sample.length}}">
            <view class="mini-avatar" wx:for="{{item.sample}}" wx:for-item="sample" wx:key="id" style="background-color: {{sample.color}};">{{sample.initial}}</view>
          </view>
          <text class="region-name">{{item.label}}</text>
        </view>
        <text class="region-count">{{item.count}} 人</text>
      </view>
      <progress class="region-bar" percent="{{item.percent}}" stroke-width="4" activeColor="#16a889" backgroundColor="#e8eef0" />
      <text class="region-arrow">›</text>
    </button>
  </view>

  <view wx:if="{{!loading && !error && citySelected && filteredContacts.length}}" class="contact-list">
    <view class="contact-row" wx:for="{{filteredContacts}}" wx:key="id" data-id="{{item.id}}" bindtap="focusContact">
      <view class="avatar" style="background-color: {{item.color}};">{{item.initial}}</view>
      <view class="contact-info">
        <view class="contact-name">{{item.name}}</view>
        <view class="contact-meta">{{item.organization}}<text wx:if="{{item.position}}"> · {{item.position}}</text></view>
        <view class="contact-tags" wx:if="{{item.tags.length}}">
          <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>
      </view>
      <text class="contact-location-action {{item.approximate ? 'contact-location-action--needed' : ''}}" catchtap="setContactLocation" data-id="{{item.id}}">{{item.approximate ? '位置估算 · 设置' : '设置位置'}}</text>
      <text class="region-arrow">›</text>
    </view>
  </view>

  <view wx:if="{{keyword && (globalRegions.length || globalContacts.length)}}" class="global-results">
    <view class="global-head">{{(citySelected ? filteredContacts.length : filteredRegions.length) ? '其他地区的结果' : '当前' + levelTitle + '中没有匹配，以下是其他地区的结果'}}</view>
    <view wx:if="{{globalRegions.length}}" class="region-list">
      <button class="region-row global-row" wx:for="{{globalRegions}}" wx:key="key" data-key="{{item.key}}" bindtap="openGlobalRegion">
        <view class="region-main"><text class="region-name">{{item.label}}</text><text class="region-count">{{item.count}} 人</text></view>
        <text class="region-arrow">›</text>
      </button>
    </view>
    <view wx:if="{{globalContacts.length}}" class="contact-list">
      <view class="contact-row" wx:for="{{globalContacts}}" wx:key="id" data-id="{{item.id}}" bindtap="openGlobalContact">
        <view class="contact-info">
          <view class="contact-name">{{item.name}}</view>
          <view class="contact-meta">{{item.place}}<text wx:if="{{item.organization}}"> · {{item.organization}}</text></view>
        </view>
        <text class="region-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="app-state" wx:if="{{loading}}" role="status">正在加载地区数据…</view>
  <view class="app-state app-state--error" wx:elif="{{error}}"><text>{{error}}</text><button class="app-action" bindtap="load">重新加载</button></view>
  <view class="app-state" wx:elif="{{keyword && (citySelected ? !filteredContacts.length : !filteredRegions.length) && !globalRegions.length && !globalContacts.length}}"><text>没有找到“{{keyword}}”</text><button class="app-action" bindtap="clearKeyword">清除搜索</button></view>
  <view class="app-state" wx:elif="{{!keyword && (citySelected ? !filteredContacts.length : !filteredRegions.length)}}">{{citySelected ? '该城市暂无联系人' : '暂无' + levelTitle + '数据，添加联系人并填写地区后会显示在这里'}}</view>
</view>
