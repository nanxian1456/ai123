<view class="page map-page">
  <view class="map-hero"><view class="globe"><view class="latitude a"></view><view class="latitude b"></view><view class="longitude a"></view><view class="longitude b"></view><view class="city-dot one"></view><view class="city-dot two"></view><view class="city-dot three"></view></view><view class="hero-copy"><view>全球人脉分布</view><text>连接地域，发现更多可能</text></view><view class="total-panel"><view><text>{{total}}</text><text>联系人</text></view><view><text>{{cities.length}}</text><text>城市</text></view><view><text>{{topCity}}</text><text>覆盖最多</text></view></view></view>
  <view class="section-head"><view>城市分布</view><text>点击查看联系人</text></view><view class="city-list" wx:if="{{cities.length}}"><view class="city-row" wx:for="{{cities}}" wx:key="name" data-city="{{item.name}}" bindtap="contacts"><view class="city-mark">●</view><view class="city-name">{{item.name}}</view><view class="bar"><view style="width: {{item.percent}}%;"></view></view><view class="count">{{item.count}} 人</view><text class="arrow">›</text></view></view><view class="empty" wx:else>暂无城市数据，新增联系人后将在这里展示</view>
</view>
