<view class="page">
  <view class="map-hero"><view class="map-title">关系资源分布</view><view class="map-number">{{total}}</view><view class="map-label">已记录联系人</view><view class="orbit orbit-one"></view><view class="orbit orbit-two"></view><view class="dot dot-one"></view><view class="dot dot-two"></view></view>
  <view class="section-title">城市分布</view>
  <view class="card"><view class="city-row" wx:for="{{cities}}" wx:key="name" data-city="{{item.name}}" bindtap="contacts"><view class="pin">●</view><view class="city-name">{{item.name}}</view><view class="bar"><view style="width: {{item.percent}}%;"></view></view><view class="count">{{item.count}} 人</view></view><view class="empty" wx:if="{{!cities.length}}">暂无城市数据</view></view>
</view>
