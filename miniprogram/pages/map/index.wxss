.map-page { background:#f2f6f9; }.map-hero { position:relative; height:605rpx; overflow:hidden; border-radius:17rpx; color:#fff; background:radial-gradient(circle at 48% 42%, #20577d 0, #0d2138 58%, #081625 100%); }.globe { position:absolute; right:-122rpx; bottom:-152rpx; width:570rpx; height:570rpx; border:2rpx solid rgba(128,236,222,.5); border-radius:50%; box-shadow:inset 0 0 70rpx rgba(54,176,168,.28),0 0 55rpx rgba(51,157,202,.22); }.latitude,.longitude { position:absolute; left:50%; top:50%; border:1rpx solid rgba(169,239,241,.32); transform:translate(-50%,-50%); }.latitude { width:530rpx; height:150rpx; border-radius:50%; }.latitude.a { transform:translate(-50%,-50%) rotate(-17deg); }.latitude.b { width:530rpx; height:320rpx; transform:translate(-50%,-50%) rotate(22deg); }.longitude { width:160rpx; height:520rpx; border-radius:50%; }.longitude.a { transform:translate(-50%,-50%) rotate(24deg); }.longitude.b { width:340rpx; height:530rpx; transform:translate(-50%,-50%) rotate(-25deg); }.city-dot { position:absolute; width:18rpx; height:18rpx; border-radius:50%; background:#58f4c9; box-shadow:0 0 24rpx #58f4c9; }.city-dot.one { left:174rpx; top:179rpx; }.city-dot.two { left:341rpx; top:278rpx; background:#60b7ff; box-shadow:0 0 24rpx #60b7ff; }.city-dot.three { left:132rpx; top:365rpx; background:#f3b35f; box-shadow:0 0 24rpx #f3b35f; }.hero-copy { position:absolute; left:34rpx; top:45rpx; }.hero-copy view { font-size:38rpx; font-weight:700; }.hero-copy text { display:block; margin-top:10rpx; color:#b7d3e6; font-size:23rpx; }.total-panel { position:absolute; left:26rpx; right:26rpx; bottom:25rpx; display:flex; padding:21rpx 0; border:1rpx solid rgba(255,255,255,.14); border-radius:11rpx; background:rgba(4,19,34,.65); }.total-panel view { flex:1; display:flex; flex-direction:column; align-items:center; border-right:1rpx solid rgba(255,255,255,.15); }.total-panel view:last-child { border:0; }.total-panel text:first-child { color:#fff; font-size:31rpx; font-weight:700; }.total-panel text:last-child { margin-top:5rpx; color:#9ec3db; font-size:19rpx; }.section-head { display:flex; align-items:end; justify-content:space-between; margin:40rpx 4rpx 17rpx; }.section-head view { color:#17324e; font-size:32rpx; font-weight:700; }.section-head text { color:#8997a3; font-size:22rpx; }.city-list { padding:0 24rpx; border-radius:14rpx; background:#fff; box-shadow:0 7rpx 22rpx rgba(19,58,99,.05); }.city-row { display:flex; align-items:center; height:91rpx; border-bottom:1rpx solid #eef1f3; }.city-row:last-child { border:0; }.city-mark { margin-right:13rpx; color:#18ad8b; font-size:22rpx; }.city-name { width:114rpx; color:#293e50; font-size:28rpx; }.bar { flex:1; height:12rpx; overflow:hidden; border-radius:8rpx; background:#e8eef0; }.bar view { height:100%; min-width:10rpx; border-radius:inherit; background:linear-gradient(90deg,#17b98e,#55d7ca); }.count { width:67rpx; color:#637888; text-align:right; font-size:23rpx; }.arrow { margin-left:10rpx; color:#89a0af; font-size:32rpx; }.empty { padding:54rpx 24rpx; border-radius:14rpx; background:#fff; color:#84929e; text-align:center; font-size:25rpx; }
