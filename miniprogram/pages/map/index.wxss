.map-hero { height: 390rpx; position: relative; overflow: hidden; color: #fff; border-radius: 18rpx; background: radial-gradient(circle at 50% 50%, #218bd9, #12365f 72%); padding: 54rpx 42rpx; box-sizing: border-box; }.map-title { font-size: 28rpx; opacity: .85; }.map-number { font-size: 78rpx; font-weight: 700; margin-top: 28rpx; }.map-label { font-size: 25rpx; opacity: .8; }.orbit { position: absolute; border: 2rpx solid rgba(255,255,255,.28); border-radius: 50%; }.orbit-one { width: 390rpx; height: 160rpx; right: -50rpx; top: 135rpx; transform: rotate(-25deg); }.orbit-two { width: 300rpx; height: 100rpx; right: 20rpx; top: 180rpx; transform: rotate(18deg); }.dot { width: 14rpx; height: 14rpx; border-radius: 50%; position: absolute; background: #67e8f9; box-shadow: 0 0 18rpx #67e8f9; }.dot-one { right: 115rpx; top: 127rpx; }.dot-two { right: 230rpx; top: 250rpx; }.city-row { display: flex; align-items: center; height: 84rpx; border-bottom: 1rpx solid #eef1f4; }.city-row:last-child { border: 0; }.pin { color: #1677d2; margin-right: 13rpx; }.city-name { width: 105rpx; font-size: 28rpx; }.bar { flex: 1; height: 13rpx; border-radius: 9rpx; background: #edf2f6; overflow: hidden; }.bar view { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #1677d2, #50c9e7); }.count { width: 75rpx; text-align: right; color: #5e7996; font-size: 25rpx; }
