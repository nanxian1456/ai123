.backup-page { padding-bottom: 48rpx; }
.backup-section { padding: 16rpx 0 28rpx; border-bottom: 1rpx solid #dce5ed; }
.backup-section input { box-sizing: border-box; width: 100%; height: 88rpx; padding: 0 18rpx; border: 1rpx solid #cbd7e1; border-radius: 6rpx; background: #fff; font-size: 28rpx; }
.backup-section button { margin: 18rpx 0 0; border-radius: 6rpx; font-size: 28rpx; }
.backup-section text { display: block; margin-top: 16rpx; color: #627487; font-size: 24rpx; line-height: 1.5; }
.secondary-button { background: #e8f2fa; color: #176b9d; }
.preview-title { font-size: 30rpx; font-weight: 600; color: #263c4e; }
.preview view:not(.preview-title) { display: flex; justify-content: space-between; gap: 16rpx; padding: 10rpx 0; font-size: 26rpx; }
.preview view text { margin: 0; }
.danger-button { background: #a43f37; color: #fff; }
