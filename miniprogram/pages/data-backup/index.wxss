.backup-page { padding-bottom: 48rpx; }
.backup-section { padding: 16rpx 0 28rpx; border-bottom: 1rpx solid #dce5ed; }
.backup-section input { box-sizing: border-box; width: 100%; height: 88rpx; padding: 0 18rpx; border: 1rpx solid #cbd7e1; border-radius: 6rpx; background: #fff; font-size: 28rpx; }
.backup-section button { margin: 18rpx 0 0; border-radius: 6rpx; font-size: 28rpx; }
.backup-section text { display: block; margin-top: 16rpx; color: #627487; font-size: 24rpx; line-height: 1.5; }
.secondary-button { background: #e8f2fa; color: #2563eb; }
.preview-title { font-size: 30rpx; font-weight: 600; color: #1f3a57; }
.preview view:not(.preview-title) { display: flex; justify-content: space-between; gap: 16rpx; padding: 10rpx 0; font-size: 26rpx; }
.preview view text { margin: 0; }
.danger-button { background: #a43f37; color: #fff; }

.backup-reminder { padding: 20rpx; margin-bottom: 24rpx; border-radius: 8rpx; background: #e8f2fa; color: #244b68; font-size: 26rpx; line-height: 1.6; }
.backup-status { padding: 16rpx 0; color: #2563eb; font-size: 26rpx; }
.backup-reminder,.backup-section,.preview { box-sizing:border-box; min-width:0; max-width:100%; word-wrap:break-word; }
.backup-section text,.backup-status { word-wrap:break-word; }
.backup-page .backup-section button { width:100%; }
.preview view:not(.preview-title) { min-width:0; flex-wrap:wrap; }
.preview view text { min-width:0; word-wrap:break-word; }
.backup-summary { background:#fff; border:1rpx solid var(--line); border-radius:14rpx; padding:20rpx; font-size:24rpx; color:var(--muted); word-wrap:break-word; }
.backup-summary > view { margin:8rpx 0; }
.backup-history-row { padding:20rpx 0; border-bottom:1rpx solid var(--line); font-size:25rpx; color:var(--ink); word-wrap:break-word; }
.backup-history-row > text { display:block; font-size:23rpx; color:var(--muted); margin-top:8rpx; }
.password-hint { display: flex; align-items: center; justify-content: space-between; min-height: 48rpx; }
.password-hint .ui-link { margin: 0 0 0 auto; }
.password-mismatch { color: #b42318; font-size: 24rpx; }
