.settings-menu { padding-top:40rpx; }
.module-row { display:flex; align-items:center; gap:20rpx; padding:28rpx 24rpx; margin-bottom:18rpx; border-radius:20rpx; box-shadow:none; }
.module-icon { flex:none; width:72rpx; height:72rpx; display:flex; align-items:center; justify-content:center; background:var(--accent-soft); color:var(--accent); border-radius:20rpx; font-size:27rpx; }
.module-copy { flex:1; min-width:0; }
.module-name { color:var(--ink); font-size:29rpx; font-weight:600; }
.module-copy > text { display:block; color:var(--muted); font-size:23rpx; margin-top:8rpx; }
.module-chevron { flex:none; color:#a4aeb8; font-size:35rpx; }
.module-row { box-sizing:border-box; min-width:0; max-width:100%; }
.module-copy,.module-name,.module-copy > text { word-wrap:break-word; overflow-wrap:break-word; }
.module-copy > .module-status { color:var(--accent); font-size:22rpx; }
.module-copy > .module-warning { color:#805a14; font-size:22rpx; }
