.visibility-card { padding:0 25rpx; }.visibility-tip { padding:20rpx 0 14rpx; color:#82909d; font-size:23rpx; line-height:1.6; }.visibility-row { display:flex; align-items:center; justify-content:space-between; min-height:94rpx; border-top:1rpx solid #edf1f3; color:#263c4e; font-size:29rpx; }.visibility-row switch { transform:scale(.82); transform-origin:right center; }.notice { display:flex; align-items:center; gap:17rpx; }.notice > text { width:42rpx; height:42rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; color:#fff; background:#18a88e; font-size:24rpx; }.notice view view { color:#263c4e; font-size:27rpx; font-weight:600; }.notice view text { display:block; margin-top:7rpx; color:#8795a1; font-size:21rpx; line-height:1.5; }
.logout-link { display:flex; align-items:center; justify-content:space-between; color:#cc5e58; font-size:29rpx; }.logout-link text:last-child { font-size:42rpx; font-weight:300; }
