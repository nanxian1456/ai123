.settings-page { padding-bottom:56rpx; }
.settings-intro { margin:4rpx 2rpx 30rpx; }
.settings-intro view { color:#17324e; font-size:43rpx; font-weight:700; }
.settings-intro text { display:block; margin-top:9rpx; color:#82909d; font-size:24rpx; }
.section-title { margin-top:35rpx; font-size:31rpx; }
.profile-card,.setting-list { padding:0 25rpx; }
.profile-summary { display:flex; align-items:center; min-height:132rpx; border-bottom:1rpx solid #edf1f3; }
.profile-avatar { width:78rpx; height:78rpx; flex:0 0 78rpx; border-radius:50%; background:#dcebf7; }
.profile-avatar-default { display:flex; align-items:center; justify-content:center; color:#fff; background:#1684c3; font-size:31rpx; font-weight:700; }
.profile-copy { min-width:0; margin-left:20rpx; }
.profile-copy view { overflow:hidden; color:#263c4e; font-size:30rpx; font-weight:600; text-overflow:ellipsis; white-space:nowrap; }
.profile-copy text { display:block; margin-top:8rpx; overflow:hidden; color:#8795a1; font-size:22rpx; text-overflow:ellipsis; white-space:nowrap; }
.setting-link { display:flex; align-items:center; justify-content:space-between; min-height:104rpx; }
.setting-link > view { min-width:0; }
.setting-link > view > text:first-child { display:block; color:#263c4e; font-size:28rpx; font-weight:600; }
.setting-link > view > text:last-child { display:block; margin-top:7rpx; color:#8795a1; font-size:21rpx; line-height:1.45; }
.chevron { margin-left:20rpx; color:#a5b0ba; font-size:43rpx; font-weight:300; }
.security-status { display:flex; align-items:center; min-height:118rpx; border-bottom:1rpx solid #edf1f3; }
.status-icon { width:43rpx; height:43rpx; display:flex; align-items:center; justify-content:center; flex:0 0 43rpx; border-radius:50%; color:#fff; background:#18a88e; font-size:24rpx; }
.security-status view { margin-left:18rpx; }
.security-status view text:first-child { display:block; color:#263c4e; font-size:28rpx; font-weight:600; }
.security-status view text:last-child { display:block; margin-top:7rpx; color:#8795a1; font-size:21rpx; line-height:1.45; }
.danger-link > view > text:first-child { color:#c95752; }
.friend-card { padding:25rpx; }
.friend-copy text:first-child { display:block; color:#263c4e; font-size:28rpx; font-weight:600; }
.friend-copy text:last-child { display:block; margin-top:7rpx; color:#8795a1; font-size:21rpx; line-height:1.5; }
.import-code { margin:23rpx 0 18rpx; padding:21rpx; border:1rpx solid #c9dfed; border-radius:10rpx; color:#126fa9; background:#f1f8fc; text-align:center; font-size:39rpx; font-weight:700; letter-spacing:5rpx; }
.friend-tip { color:#6f7f8d; font-size:22rpx; line-height:1.55; }
.visibility-card { padding:0 25rpx; }
.visibility-tip { padding:22rpx 0 16rpx; color:#82909d; font-size:23rpx; line-height:1.6; }
.visibility-row { display:flex; align-items:center; justify-content:space-between; min-height:94rpx; border-top:1rpx solid #edf1f3; color:#263c4e; font-size:29rpx; }
.visibility-row switch { transform:scale(.82); transform-origin:right center; }
