.privacy-mask { position: fixed; z-index: 999; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: rgba(8, 20, 36, 0.55); }
.privacy-dialog { width: 100%; padding: 40rpx 36rpx calc(36rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 28rpx 28rpx 0 0; background: #fff; }
.privacy-title { color: #163a63; font-size: 34rpx; font-weight: 700; }
.privacy-text { margin-top: 20rpx; color: #36485a; font-size: 27rpx; line-height: 1.7; }
.privacy-link { color: #1677d2; }
.privacy-actions { display: flex; gap: 22rpx; margin-top: 36rpx; }
.privacy-actions button { flex: 1; margin: 0; border-radius: 14rpx; font-size: 30rpx; }
.privacy-disagree { color: #4c5f73; background: #eef2f6; }
.privacy-agree { color: #fff; background: #1677d2; font-weight: 600; }
