<view class="auth-page">
  <view class="auth-bg">
    <video class="bg-video" src="http://127.0.0.1:8080/videos/background.mp4" autoplay="{{true}}" loop="{{true}}" muted="{{true}}" show-center-play-btn="{{false}}" show-play-btn="{{false}}" controls="{{false}}" object-fit="cover"></video>
    <view class="bg-overlay"></view>
    <view class="glow glow-1"></view>
    <view class="glow glow-2"></view>
    <view class="grid"></view>
  </view>

  <view class="auth-body">
    <view class="title">欢迎来到 AI 人脉地图</view>
    <view class="subtitle">用更清晰的方式，记录每一次重要连接</view>

    <view class="hero-image-wrap">
      <image class="hero-image" src="/assets/images/hero-network.jpg" mode="aspectFill" />
    </view>

    <view class="benefit-modules">
      <view class="benefit-card card-left">
        <view class="card-glass"></view>
        <view class="card-content">
          <view class="check-mark">✓</view>
          <view class="card-title">安全的个人空间</view>
          <view class="card-desc">数据仅自己可见</view>
        </view>
      </view>
      <view class="benefit-card card-right">
        <view class="card-glass"></view>
        <view class="card-content">
          <view class="check-mark">✓</view>
          <view class="card-title">微信快捷登录</view>
          <view class="card-desc">首次登录完成资料即可使用</view>
        </view>
      </view>
    </view>
  </view>

  <view class="login-area">
    <view class="login-button {{loggingIn ? 'disabled' : ''}}" bindtap="login">
      <text wx:if="{{!loggingIn}}">微信一键登录</text>
      <text wx:else>正在登录...</text>
      <text class="arrow">›</text>
    </view>
    <view class="agreement">登录即表示你同意以微信身份创建应用账号</view>
  </view>
</view>
