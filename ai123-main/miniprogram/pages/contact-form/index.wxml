<view class="page">
  <view class="card ai-card"><view class="form-title">AI信息预填</view><textarea placeholder="粘贴人物介绍，例如：张老师，南京邮电大学教授，研究无线感知" value="{{aiText}}" bindinput="aiInput" maxlength="500"/><button class="extract" loading="{{extracting}}" bindtap="extract">智能整理</button></view>
  <view class="section-title">联系人信息</view>
  <view class="card form">
    <view class="field"><text>姓名 *</text><input data-field="name" value="{{form.name}}" bindinput="input" placeholder="请输入姓名"/></view>
    <view class="field"><text>单位</text><input data-field="organization" value="{{form.organization}}" bindinput="input" placeholder="学校、公司或机构"/></view>
    <view class="field"><text>职务</text><input data-field="position" value="{{form.position}}" bindinput="input" placeholder="教授、产品经理等"/></view>
    <view class="field"><text>城市</text><input data-field="city" value="{{form.city}}" bindinput="input" placeholder="工作城市"/></view>
    <view class="field"><text>电话</text><input data-field="phone" value="{{form.phone}}" bindinput="input" placeholder="选填" type="number"/></view>
    <view class="field"><text>邮箱</text><input data-field="email" value="{{form.email}}" bindinput="input" placeholder="选填"/></view>
    <view class="field"><text>标签</text><input data-field="tagsText" value="{{form.tagsText}}" bindinput="input" placeholder="多个标签用逗号分隔"/></view>
    <view class="field area"><text>备注</text><textarea data-field="note" value="{{form.note}}" bindinput="input" placeholder="认识场景、合作方向等" maxlength="500"/></view>
  </view>
  <button class="primary-button save" bindtap="save">确认保存</button>
</view>
