.ai-card textarea { width: 100%; height: 130rpx; font-size: 27rpx; line-height: 1.5; margin-top: 14rpx; }.form-title { font-size: 30rpx; font-weight: 650; color: #163a63; }.extract { background: #e9f4ff; color: #1677d2; border-radius: 10rpx; margin: 12rpx 0 0; font-size: 27rpx; }.field { min-height: 82rpx; display: flex; align-items: center; border-bottom: 1rpx solid #edf0f4; }.field:last-child { border: 0; }.field > text { width: 132rpx; color: #4c5f73; font-size: 27rpx; }.field input { flex: 1; text-align: right; font-size: 27rpx; }.field.area { align-items: flex-start; padding: 20rpx 0; }.field textarea { flex: 1; height: 130rpx; font-size: 27rpx; }.save { margin-top: 30rpx; }
