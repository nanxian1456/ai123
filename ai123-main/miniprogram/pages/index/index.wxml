<view class="page">
  <view class="hero"><view class="eyebrow">PERSONAL RELATIONSHIP CRM</view><view class="hero-title">让关系，看得见</view><view class="hero-text">联系人、单位、地区与合作关系集中管理</view></view>
  <view class="stats" wx:if="{{dashboard}}"><view class="stat"><text class="num">{{dashboard.contactCount}}</text><text>联系人</text></view><view class="stat"><text class="num">{{dashboard.cityCount}}</text><text>城市</text></view><view class="stat"><text class="num">{{dashboard.organizationCount}}</text><text>单位</text></view></view>
  <view class="status-card" wx:if="{{loading}}">正在同步人脉数据</view><view class="status-card error" wx:if="{{loadError}}">{{loadError}}</view>
  <view class="section-head"><view class="section-title">快速开始</view><view class="section-subtitle">让信息沉淀成关系资产</view></view>
  <view class="featured-action" bindtap="goAi"><view class="feature-icon">AI</view><view class="feature-copy"><view class="feature-title">AI 智能整理</view><view class="feature-text">粘贴人物介绍，自动提取单位、职位和标签</view></view><view class="arrow">›</view></view>
  <view class="actions"><view class="action primary" bindtap="goAdd"><text class="action-icon">＋</text><text>手动新增</text></view><view class="action" bindtap="goContacts"><text class="action-icon">⌕</text><text>联系人库</text></view><view class="action" bindtap="goMap"><text class="action-icon">●</text><text>地域分布</text></view><view class="action" bindtap="goContacts"><text class="action-icon">⌘</text><text>关系图谱</text></view></view>
  <view class="section-title recent-title">最近联系人</view>
  <view class="card contact-list" wx:if="{{dashboard && dashboard.recentContacts.length}}"><view class="contact-row" wx:for="{{dashboard.recentContacts}}" wx:key="id" data-id="{{item.id}}" bindtap="openContact"><view class="avatar">{{item.initial}}</view><view class="contact-main"><view class="contact-name">{{item.name}}</view><view class="muted">{{item.position}} · {{item.organization}}</view></view><view class="city">{{item.city}}</view></view></view>
  <view class="empty-recent" wx:if="{{dashboard && !dashboard.recentContacts.length}}">先新增一位联系人，开始建立人脉地图</view>
</view>
