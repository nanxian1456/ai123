.entry-page { position: relative; width: 100vw; height: 100vh; overflow: hidden; background: #000; color: #fff; }.background { position: absolute; inset: 0; overflow: hidden; background: #000; }.earth-video { position: absolute; inset: 0; width: 100%; height: 100%; }
.entry-content { position: relative; z-index: 2; margin-top: 288rpx; padding: 0 45rpx; text-align: center; }.eyebrow { color: #82eae1; font-size: 19rpx; letter-spacing: 3rpx; }.headline { margin-top: 20rpx; color: #fff; font-size: 86rpx; line-height: 1.15; font-weight: 700; letter-spacing: 3rpx; }.subtitle { margin-top: 24rpx; color: rgba(255,255,255,.78); font-size: 28rpx; }.entry-action { position: absolute; z-index: 3; left: 38rpx; right: 38rpx; bottom: 64rpx; }.button { position: relative; height: 108rpx; display: flex; align-items: center; justify-content: center; gap: 15rpx; overflow: hidden; border-radius: 54rpx; font-family: SimSun, "宋体", serif; font-size: 34rpx; }.primary { color: #0c1724; background: #fff; font-weight: 700; border: 2rpx solid #fff; box-shadow: 0 14rpx 42rpx rgba(255,255,255,.2); animation: buttonBreathe 2.8s ease-in-out infinite; }.button-label,.arrow { position: relative; z-index: 2; }.arrow { font-size: 52rpx; font-weight: 300; line-height: 1; animation: arrowDrift 1.7s ease-in-out infinite; }.button-particles { position: absolute; inset: 0; overflow: hidden; }.particle { position: absolute; width: 8rpx; height: 8rpx; border-radius: 50%; background: #4bb2ed; opacity: 0; box-shadow: 0 0 12rpx rgba(45,155,226,.8); animation: particleFlow 3.4s linear infinite; }.p1 { left: 8%; top: 64%; animation-delay: 0s; }.p2 { left: 23%; top: 26%; width: 6rpx; height: 6rpx; animation-delay: -.8s; }.p3 { left: 39%; top: 71%; width: 10rpx; height: 10rpx; animation-delay: -1.6s; }.p4 { left: 56%; top: 34%; width: 6rpx; height: 6rpx; animation-delay: -.3s; }.p5 { left: 70%; top: 74%; animation-delay: -2.1s; }.p6 { left: 83%; top: 24%; width: 10rpx; height: 10rpx; animation-delay: -1.1s; }.p7 { left: 92%; top: 61%; width: 6rpx; height: 6rpx; animation-delay: -2.7s; } @keyframes particleFlow { 0% { opacity: 0; transform: translate(-20rpx, 16rpx) scale(.4); } 18% { opacity: .82; } 70% { opacity: .52; } 100% { opacity: 0; transform: translate(36rpx, -34rpx) scale(1.35); } } @keyframes buttonBreathe { 0%,100% { box-shadow: 0 14rpx 42rpx rgba(255,255,255,.2); transform: translateY(0); } 50% { box-shadow: 0 19rpx 54rpx rgba(101,201,255,.42); transform: translateY(-4rpx); } } @keyframes arrowDrift { 0%,100% { transform: translateX(0); } 50% { transform: translateX(7rpx); } }
