.me-hero { display:flex; align-items:center; position:relative; padding:38rpx 28rpx; border-radius:16rpx; color:#fff; background:#12365f; }.avatar { width:106rpx; height:106rpx; display:flex; align-items:center; justify-content:center; border:6rpx solid rgba(218,255,250,.62); border-radius:50%; color:#0b5c5b; background:#bdebe3; font-size:40rpx; font-weight:700; }.main { min-width:0; flex:1; margin-left:21rpx; }.main view { font-size:38rpx; font-weight:700; }.main text { display:block; margin-top:7rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#d1e5ee; font-size:23rpx; }.edit { position:absolute; right:25rpx; top:24rpx; padding:8rpx 15rpx; border:1rpx solid rgba(255,255,255,.35); border-radius:8rpx; font-size:22rpx; }.details > view { display:flex; justify-content:space-between; align-items:flex-start; gap:28rpx; padding:22rpx 0; border-bottom:1rpx solid #edf1f3; font-size:27rpx; }.details > view:last-child { border:0; }.details text:first-child { flex:0 0 150rpx; color:#82909d; }.details text:last-child { color:#263c4e; text-align:right; word-break:break-all; }.notice { display:flex; align-items:center; gap:17rpx; }.notice > text { width:42rpx; height:42rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; color:#fff; background:#18a88e; font-size:24rpx; }.notice view view { color:#263c4e; font-size:27rpx; font-weight:600; }.notice view text { display:block; margin-top:7rpx; color:#8795a1; font-size:21rpx; line-height:1.5; }
