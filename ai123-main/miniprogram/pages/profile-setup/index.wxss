.profile-intro { margin:14rpx 4rpx 27rpx; }.profile-intro .step { color:#169b86; font-size:22rpx; font-weight:600; }.profile-intro view:nth-child(2) { margin-top:10rpx; color:#17324e; font-size:37rpx; font-weight:700; }.profile-intro text { display:block; margin-top:9rpx; color:#8593a2; font-size:23rpx; }.avatar-preview { width:105rpx; height:105rpx; margin:8rpx auto 30rpx; display:flex; align-items:center; justify-content:center; border:6rpx solid #d9f3ef; border-radius:50%; color:#147d75; background:#bfece3; font-size:40rpx; font-weight:700; }.form-card { padding:0 25rpx; border-radius:14rpx; background:#fff; box-shadow:0 7rpx 22rpx rgba(19,58,99,.05); }.field { min-height:96rpx; display:flex; align-items:center; border-bottom:1rpx solid #edf1f3; }.field:last-child { border:0; }.field > text { width:158rpx; color:#53687a; font-size:27rpx; }.field input { flex:1; color:#20394d; font-size:27rpx; }.field.bio { align-items:flex-start; padding:24rpx 0; }.field textarea { flex:1; height:142rpx; color:#20394d; font-size:26rpx; }.save-button { height:96rpx; display:flex; align-items:center; justify-content:center; margin-top:33rpx; border-radius:12rpx; color:#fff; background:#1684c3; font-size:30rpx; font-weight:600; }
